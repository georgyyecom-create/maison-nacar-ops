{%- liquid
  assign S = section.settings
  assign v1 = product.variants[0]
  assign sel = product.variants[0]
  if product.variants.size > 1
    assign sel = product.variants[1]
  endif
  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value
  if rating == blank
    assign rating = S.rating_value
    assign rating_count = S.rating_count
  endif
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<div class="zn-bar">
  <p class="zn-bar__txt">{{ S.bar_text }}</p>
  <div class="zn-clock" data-deadline="{{ S.deadline_iso }}" aria-label="Tiempo que queda">
    <span><b data-u="d">--</b><i>días</i></span><span><b data-u="h">--</b><i>horas</i></span><span><b data-u="m">--</b><i>min</i></span><span><b data-u="s">--</b><i>seg</i></span>
  </div>
</div>

<header class="zn-head">
  <div class="zn-in zn-head__row">
    {% render 'zn-logo', tagline: S.tagline %}
    <a class="zn-head__cart" href="{{ routes.cart_url }}" data-cart-open aria-label="Abrir carrito"><span class="zn-head__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l-1.2 12H6.2L5 7Z M9 7a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
    </a>
  </div>
</header>
<p class="zn-sub">{{ S.sub_text }}</p>

<main class="zn-main">
  <section class="zn-pdp zn-in">
    <div class="zn-gal" data-gal>
      <div class="zn-gal__track" data-track tabindex="0" aria-label="Fotos del producto">
        {%- if product.media.size > 0 -%}
          {%- for m in product.media -%}
            {%- if m.media_type == 'image' -%}
              <figure class="zn-gal__slide">{%- if forloop.first -%}{{ m | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,800,1100,1400', sizes: '(min-width: 960px) 560px, 100vw' }}{%- else -%}{{ m | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width: 960px) 560px, 100vw' }}{%- endif -%}</figure>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'FOTO 01 · Portada: cojín sobre fondo azul marino con 4 sellos', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'FOTO 02 · Persona de 55–65 años dormida de lado con el cojín entre las rodillas', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'FOTO 03 · Sin cojín / Con cojín: línea de la cadera', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'FOTO 04 · Medidas del cojín', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'FOTO 05 · Pack de 2 + antifaz de regalo', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'FOTO 06 · Funda quitándose para lavar', ratio: '1/1' %}</figure>
        {%- endif -%}
      </div>
      <div class="zn-gal__thumbs" data-thumbs aria-label="Elegir foto"></div>
    </div>

    <div class="zn-info">
      {%- if S.show_stars and rating != blank -%}
        <p class="zn-rate"><span class="zn-stars" style="--r: {{ rating }}" aria-hidden="true">★★★★★</span><b>{{ rating }}/5</b>{%- if rating_count != blank -%}<span>· {{ rating_count }} {{ S.rating_label }}</span>{%- endif -%}</p>
      {%- endif -%}
      <h1 class="zn-title">{{ product.title }}</h1>
      <ul class="zn-checks">
        {%- for b in section.blocks -%}{%- if b.type == 'check' -%}
          <li {{ b.shopify_attributes }}><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path d="m6 10.4 2.6 2.6L14 7.6"/></svg>{{ b.settings.text }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>

      <div class="zn-offer">
        <p class="zn-offer__head"><span>{{ S.offer_title }}</span></p>
        <p class="zn-offer__sub">{{ S.offer_sub }} <b data-short-clock>—</b></p>

        {%- form 'product', product, id: 'zn-form', class: 'zn-form' -%}
          <input type="hidden" name="return_to" value="/checkout">
          <div class="zn-packs" role="radiogroup" aria-label="Elige tu pack">
            {%- for v in product.variants -%}
              {%- liquid
                assign q = forloop.index
                assign per = v.price | divided_by: q
                assign sep = v1.price | times: q
                assign save = sep | minus: v.price
              -%}
              <label class="zn-pack{% if v.id == sel.id %} is-on{% endif %}" data-price="{% render 'zn-money', cents: v.price %}">
                <input type="radio" name="id" value="{{ v.id }}" {% if v.id == sel.id %}checked{% endif %}>
                {%- if q == 2 and S.badge2 != blank -%}<span class="zn-pack__badge">{{ S.badge2 }}</span>{%- endif -%}
                <span class="zn-pack__top">
                  <span class="zn-pack__radio" aria-hidden="true"></span>
                  <span class="zn-pack__name">
                    <b>{% if q == 1 %}1 cojín{% else %}{{ q }} cojines{% endif %}</b>
                    <small>{% if q == 1 %}+ {{ S.ship_fee }} de envío{% else %}Ahorras {% render 'zn-money', cents: save %} · envío gratis{% endif %}</small>
                  </span>
                  <span class="zn-pack__price">
                    <b>{% render 'zn-money', cents: v.price %}</b>
                    {%- if q > 1 -%}<s>{% render 'zn-money', cents: sep %}</s><small>{% render 'zn-money', cents: per %} por cojín</small>{%- endif -%}
                  </span>
                </span>
                {%- if q >= 2 -%}
                  <span class="zn-gift">
                    <span class="zn-gift__img">{% render 'zn-img', img: S.gift1_img, label: 'Antifaz', ratio: '1/1' %}</span>
                    <span class="zn-gift__name">+ {{ S.gift1_name }}</span><em>Regalo</em>
                  </span>
                {%- endif -%}
                {%- if q >= 3 -%}
                  <span class="zn-gift">
                    <span class="zn-gift__img">{% render 'zn-img', img: S.gift2_img, label: 'Altavoz', ratio: '1/1' %}</span>
                    <span class="zn-gift__name">+ {{ S.gift2_name }}</span><em>Regalo</em>
                  </span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
          <p class="zn-fine">{{ S.fine_print }}</p>{%- if S.show_cod -%}<div class="zn-cod"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg><p><b>{{ S.cod_title }}</b><span>{{ S.cod_sub }}</span></p></div>{%- endif -%}

          {%- if S.stock_text != blank -%}
            <p class="zn-stock"><span class="zn-dot" aria-hidden="true"></span>{{ S.stock_text }}</p>
          {%- endif -%}

          <button type="submit" class="zn-btn zn-btn--buy" data-buy>
            <span data-buy-price>{% render 'zn-money', cents: sel.price %}</span><span class="zn-btn__sep" aria-hidden="true"></span><span>{{ S.cta }}</span>
          </button>
        {%- endform -%}

        <div class="zn-pay">
          {%- if S.show_cod -%}<span class="zn-pay__cod">{{ S.cod_text }}</span>{%- endif -%}
          <span class="zn-pay__icons">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'zn-pay__icon' }}{%- endfor -%}</span>
        </div>

        <ul class="zn-assure">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.3 2.3 4.2-4.6"/></svg>{{ S.assure1 }}</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>{{ S.assure2 }}</li>
        </ul>

        {%- if S.wa_number != blank -%}<a class="zn-wa-line" href="https://wa.me/{{ S.wa_number }}?text={{ S.wa_text | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3.1.2.1.8-.1 1.4Z"/></svg><span>¿Dudas? <b>Escríbenos por WhatsApp</b></span></a>{%- endif -%}
        <p class="zn-eta" data-eta data-min="{{ S.eta_min }}" data-max="{{ S.eta_max }}"><span class="zn-eta__dot" aria-hidden="true"></span><span>Pide hoy y llega entre el <b data-eta-a>—</b> y el <b data-eta-b>—</b></span></p>
      </div>

      {%- if S.show_reviews and review_blocks.size > 0 -%}
        <div class="zn-mini" data-mini>
          {%- for b in review_blocks limit: 5 -%}
            <figure class="zn-mini__card{% if forloop.first %} is-on{% endif %}" {{ b.shopify_attributes }}>
              {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'zn-mini__img', alt: b.settings.name }}{%- endif -%}
              <figcaption><b>{{ b.settings.name }}</b> <span class="zn-stars zn-stars--s" style="--r: {{ b.settings.stars }}" aria-label="{{ b.settings.stars }} de 5">★★★★★</span><span>{{ b.settings.text | truncate: 140 }}</span></figcaption>
            </figure>
          {%- endfor -%}
          {%- if review_blocks.size > 1 -%}<div class="zn-mini__nav"><button type="button" data-mini-prev aria-label="Anterior">‹</button><button type="button" data-mini-next aria-label="Siguiente">›</button></div>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="zn-acc">
        {%- if product.description != blank -%}
          <details><summary>Descripción</summary><div class="zn-acc__body zn-rte">{{ product.description }}</div></details>
        {%- endif -%}
        {%- for b in section.blocks -%}{%- if b.type == 'info' -%}
          <details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><div class="zn-acc__body zn-rte">{{ b.settings.a }}</div></details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  <section class="zn-split zn-in">
    <div class="zn-split__img">{% render 'zn-img', img: S.img_problem, label: 'FOTO 07 · Cadera girada al dormir de lado sin cojín (ilustración anatómica sobria, tonos azules)', ratio: '1/1' %}</div>
    <div class="zn-split__txt">
      <p class="zn-kicker">{{ S.p_kicker }}</p>
      <h2 class="zn-h2">{{ S.p_title }}</h2>
      <div class="zn-rte">{{ S.p_text }}</div>
    </div>
  </section>

  <section class="zn-split zn-split--rev zn-in">
    <div class="zn-split__img zn-pair">
      <figure>{% render 'zn-img', img: S.img_sin, label: 'FOTO 08 · Sin cojín: rodillas juntas', ratio: '4/5' %}<figcaption>Sin cojín</figcaption></figure>
      <figure>{% render 'zn-img', img: S.img_con, label: 'FOTO 09 · Con cojín: piernas paralelas', ratio: '4/5' %}<figcaption>Con Zentia</figcaption></figure>
    </div>
    <div class="zn-split__txt">
      <p class="zn-kicker">{{ S.s_kicker }}</p>
      <h2 class="zn-h2">{{ S.s_title }}</h2>
      <div class="zn-rte">{{ S.s_text }}</div>
      <a class="zn-btn zn-btn--ghost" href="#zn-form">{{ S.cta_mid }}</a>
    </div>
  </section>

  <section class="zn-steps zn-in">
    <h2 class="zn-h2 zn-center">{{ S.steps_title }}</h2>
    <ol class="zn-steps__list">
      {%- for b in section.blocks -%}{%- if b.type == 'step' -%}{%- assign n = n | plus: 1 -%}
        <li {{ b.shopify_attributes }}>
          {% render 'zn-img', img: b.settings.image, label: b.settings.label, ratio: '4/3' %}
          <h3><span class="zn-steps__n">{{ n }}</span>{{ b.settings.title }}</h3>
          <p>{{ b.settings.text }}</p>
        </li>
      {%- endif -%}{%- endfor -%}
    </ol>
  </section>

  <section class="zn-cmp zn-in">
    <h2 class="zn-h2 zn-center">{{ S.cmp_title }}</h2>
    <div class="zn-cmp__wrap">
      <table class="zn-cmp__t">
        <thead><tr><th scope="col"><span class="zn-sr">Característica</span></th><th scope="col" class="is-us">Zentia</th><th scope="col">{{ S.cmp_other }}</th></tr></thead>
        <tbody>
          {%- for b in section.blocks -%}{%- if b.type == 'row' -%}
            <tr {{ b.shopify_attributes }}><th scope="row">{{ b.settings.text }}</th><td class="is-us"><span class="zn-yes" aria-label="Sí">✓</span></td><td>{%- if b.settings.other -%}<span class="zn-yes zn-yes--o" aria-label="Sí">✓</span>{%- else -%}<span class="zn-no" aria-label="No">✕</span>{%- endif -%}</td></tr>
          {%- endif -%}{%- endfor -%}
        </tbody>
      </table>
    </div>
  </section>

  <section class="zn-split zn-in">
    <div class="zn-split__img">{% render 'zn-img', img: S.img_gift, label: 'FOTO 10 · Caja abierta con 2 cojines y el antifaz, papel de regalo', ratio: '1/1' %}</div>
    <div class="zn-split__txt">
      <p class="zn-kicker">{{ S.g_kicker }}</p>
      <h2 class="zn-h2">{{ S.g_title }}</h2>
      <div class="zn-rte">{{ S.g_text }}</div>
      <a class="zn-btn zn-btn--ghost" href="#zn-form" data-pick="2">{{ S.g_cta }}</a>
    </div>
  </section>

  <section class="zn-guar">
    <div class="zn-in zn-guar__row">
      <div class="zn-guar__seal" aria-hidden="true"><b>{{ S.nights }}</b><span>noches</span></div>
      <div>
        <h2 class="zn-h2">{{ S.guar_title }}</h2>
        <p>{{ S.guar_text }}</p>
      </div>
    </div>
  </section>

  {%- if S.show_reviews and review_blocks.size > 0 -%}
    <section class="zn-revs zn-in" id="opiniones">
      <h2 class="zn-h2 zn-center">{{ S.reviews_title }}</h2>
      {%- if S.show_stars and rating != blank -%}<p class="zn-rate zn-rate--c"><span class="zn-stars" style="--r: {{ rating }}" aria-hidden="true">★★★★★</span><b>{{ rating }}/5</b>{%- if rating_count != blank -%}<span>· {{ rating_count }} {{ S.rating_label }}</span>{%- endif -%}</p>{%- endif -%}
      <div class="zn-revs__grid">
        {%- for b in review_blocks -%}
          <article class="zn-rev" {{ b.shopify_attributes }}>
            {%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'zn-rev__img', widths: '350,700', sizes: '(min-width: 960px) 360px, 90vw', alt: b.settings.name }}{%- endif -%}
            <span class="zn-stars zn-stars--s" style="--r: {{ b.settings.stars }}" aria-label="{{ b.settings.stars }} de 5">★★★★★</span>
            <p>{{ b.settings.text }}</p>
            <footer><b>{{ b.settings.name }}</b>{%- if b.settings.place != blank -%} · {{ b.settings.place }}{%- endif -%}{%- if b.settings.verified -%}<span class="zn-rev__ok">Compra verificada</span>{%- endif -%}</footer>
          </article>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <section class="zn-faq zn-in">
    <h2 class="zn-h2 zn-center">Preguntas frecuentes</h2>
    <div class="zn-acc zn-acc--big">
      {%- for b in section.blocks -%}{%- if b.type == 'faq' -%}
        <details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><div class="zn-acc__body zn-rte">{{ b.settings.a }}</div></details>
      {%- endif -%}{%- endfor -%}
    </div>
  </section>

  <section class="zn-final zn-in">
    <h2 class="zn-h2">{{ S.final_title }}</h2>
    <a class="zn-btn zn-btn--buy" href="#zn-form">{{ S.cta_mid }}</a>
  </section>
</main>

<footer class="zn-foot">
  <div class="zn-in">
    {% render 'zn-logo', tagline: S.tagline %}
    <nav class="zn-foot__nav" aria-label="Políticas">
      {%- for p in shop.policies -%}<a href="{{ p.url }}">{{ p.title }}</a>{%- endfor -%}
    </nav>
    <p class="zn-foot__small">{{ S.foot_note }}</p>
  </div>
</footer>

<div class="zn-sticky" data-sticky aria-hidden="true">
  <div class="zn-sticky__txt"><b>{{ product.title | truncate: 34 }}</b><span data-sticky-price>{% render 'zn-money', cents: sel.price %}</span></div>
  <a class="zn-btn zn-btn--buy zn-btn--sm" href="#zn-form" tabindex="-1">{{ S.cta_sticky }}</a>
</div>

{%- if S.wa_number != blank and S.wa_float -%}<a class="zn-wa" data-wa href="https://wa.me/{{ S.wa_number }}?text={{ S.wa_text | url_encode }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3.1.2.1.8-.1 1.4Z"/></svg></a>{%- endif -%}
{% render 'zn-cart', product: product, cod_text: S.cod_text, guide_show: S.guide_show, guide_name: S.guide_name, guide_price: S.guide_price %}
<script src="{{ 'zn.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Zentia · ficha",
  "tag": "div",
  "class": "zn-root",
  "settings": [
    { "type": "text", "id": "bar_text", "label": "Barra superior", "default": "Llega antes de Nochebuena · quedan" },
    { "type": "text", "id": "deadline_iso", "label": "Fecha límite real (ISO)", "default": "2026-12-15T23:59:00+01:00" },
    { "type": "text", "id": "tagline", "label": "Lema bajo la marca", "default": "Descanso y postura" },
    { "type": "text", "id": "sub_text", "label": "Franja bajo la cabecera", "default": "Pago contra reembolso · Envío gratis desde 2 cojines" },
    { "type": "checkbox", "id": "show_stars", "label": "Mostrar estrellas arriba (solo con reseñas reales)", "default": false },
    { "type": "text", "id": "rating_value", "label": "Nota media manual (p. ej. 4.7) si no hay app de reseñas" },
    { "type": "text", "id": "rating_count", "label": "Número de reseñas manual" },
    { "type": "text", "id": "rating_label", "label": "Texto tras el número", "default": "opiniones" },
    { "type": "checkbox", "id": "show_reviews", "label": "Mostrar reseñas (bloques «Reseña»)", "default": false },
    { "type": "text", "id": "reviews_title", "label": "Título de reseñas", "default": "Lo que dicen quienes ya lo usan" },
    { "type": "text", "id": "offer_title", "label": "Título de la oferta", "default": "Elige tu pack" },
    { "type": "text", "id": "offer_sub", "label": "Texto antes de la cuenta atrás", "default": "Llega antes de Nochebuena si pides en" },
    { "type": "text", "id": "badge2", "label": "Etiqueta del pack de 2", "default": "Recomendado" },
    { "type": "text", "id": "ship_fee", "label": "Envío del pack de 1", "default": "4,95 €" },
    { "type": "text", "id": "gift1_name", "label": "Regalo 1 (pack de 2 y 3)", "default": "Antifaz para dormir" },
    { "type": "image_picker", "id": "gift1_img", "label": "Foto del regalo 1" },
    { "type": "text", "id": "gift2_name", "label": "Regalo 2 (pack de 3)", "default": "Altavoz con sonidos para dormir" },
    { "type": "image_picker", "id": "gift2_img", "label": "Foto del regalo 2" },
    { "type": "text", "id": "fine_print", "label": "Nota bajo los packs", "default": "Precio tachado: lo que costarían los mismos cojines comprados de uno en uno." },
    { "type": "text", "id": "stock_text", "label": "Aviso de stock (vacío = oculto, solo si es verdad)" },
    { "type": "text", "id": "cta", "label": "Botón", "default": "Añadir al carrito" },
    { "type": "text", "id": "wa_number", "label": "WhatsApp (con prefijo, sin +)", "default": "34621390548" },
    { "type": "text", "id": "wa_text", "label": "Mensaje inicial de WhatsApp", "default": "Hola, tengo una duda sobre el cojín de rodillas Zentia" },
    { "type": "checkbox", "id": "wa_float", "label": "Botón flotante de WhatsApp", "default": true }, { "type": "checkbox", "id": "guide_show", "label": "Carrito: mostrar la guía PDF de regalo (solo si ya existe)", "default": true }, { "type": "text", "id": "guide_name", "label": "Carrito: nombre de la guía", "default": "Guía PDF para dormir mejor de lado" }, { "type": "text", "id": "guide_price", "label": "Carrito: precio de la guía vendida por separado (vacío = solo Gratis)" },
