{%- liquid
  assign S = section.settings
  assign v1 = product.variants[0]
  assign sel = product.variants[0]
  if product.variants.size > 1
    assign sel = product.variants[1]
  endif
  assign per2 = sel.price | divided_by: 2
  assign sep2 = v1.price | times: 2
-%}
<div class="zn-ticker" role="region" aria-label="Avisos">
  <div class="zn-ticker__track">
    {%- for i in (1..2) -%}
      <ul class="zn-ticker__list" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for b in section.blocks -%}
          {%- if b.type == 'tick' -%}
            <li {{ b.shopify_attributes }}>{{ b.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

<header class="zn-head">
  <div class="zn-in zn-head__row">
    {% render 'zn-logo' %}
    <span class="zn-head__ship"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" fill="currentColor"/><circle cx="17" cy="17.5" r="1.8" fill="currentColor"/></svg>{{ S.ship_short }}</span>
  </div>
</header>

<main class="zn-main">
  <section class="zn-hero zn-in">
    <div class="zn-gal" aria-label="Fotos del producto">
      {%- if product.media.size > 0 -%}
        {%- for m in product.media -%}
          {%- if m.media_type == 'image' -%}{{ m | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,900,1200', sizes: '(min-width: 900px) 540px, 88vw', class: 'zn-gal__img' }}{%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {% render 'zn-img', img: S.img_hero, label: 'FOTO 01 · Cojín entre las rodillas, persona dormida de lado', ratio: '4/5', cls: 'zn-gal__img' %}
        {% render 'zn-img', img: S.img_pack, label: 'FOTO 02 · Los 2 cojines sobre la cama', ratio: '4/5', cls: 'zn-gal__img' %}
        {% render 'zn-img', img: S.img_detail, label: 'FOTO 03 · Detalle de la espuma y la forma', ratio: '4/5', cls: 'zn-gal__img' %}
      {%- endif -%}
    </div>
    <div class="zn-hero__copy">
      <h1 class="zn-h1">{{ S.headline }}</h1>
      <p class="zn-lead">{{ S.subhead }}</p>
      <p class="zn-bill"><s>{% render 'zn-money', cents: sep2 %}</s><span class="zn-bill__big">2 por {% render 'zn-money', cents: sel.price %}</span><span class="zn-bill__small">Envío gratis y guía de regalo</span></p>
    </div>
  </section>

  <section class="zn-buy zn-in" id="zn-comprar" aria-label="Elegir y comprar">
    <div class="zn-live">
      <p class="zn-stock"><span class="zn-dot" aria-hidden="true"></span><span>{{ S.stock_text }}</span></p>
      <p class="zn-count" data-deadline="{{ S.deadline_iso }}"><span>{{ S.deadline_label }}</span> <span class="zn-count__t">—</span></p>
    </div>
    {%- form 'product', product, id: 'zn-form', class: 'zn-form' -%}
      <input type="hidden" name="return_to" value="/checkout">
      <div class="zn-offers" role="radiogroup" aria-label="Cantidad">
        {%- for v in product.variants -%}
          {%- liquid
            assign q = forloop.index
            assign per = v.price | divided_by: q
            assign sep = v1.price | times: q
            assign save = sep | minus: v.price
            case q
              when 1
                assign note = S.note_1
                assign tag = ''
              when 2
                assign note = S.note_2
                assign tag = S.tag_2
              else
                assign note = S.note_3
                assign tag = S.tag_3
            endcase
          -%}
          <label class="zn-offer{% if q == 2 %} zn-offer--best{% endif %}" for="zn-v{{ v.id }}">
            <input type="radio" name="id" id="zn-v{{ v.id }}" value="{{ v.id }}" data-title="{{ v.title | escape }}" data-price="{% render 'zn-money', cents: v.price %}" {% if v.id == sel.id %}checked{% endif %}>
            {%- if tag != blank -%}<span class="zn-offer__tag">{{ tag }}</span>{%- endif -%}
            <span class="zn-offer__top">
              <span class="zn-offer__name">{{ v.title }} <small>{{ note }}</small></span>
              <span class="zn-offer__prices">
                {%- if q > 1 -%}<s>{% render 'zn-money', cents: sep %}</s>{%- endif -%}
                <b>{% render 'zn-money', cents: v.price %}</b>
              </span>
            </span>
            <span class="zn-offer__perks">
              {%- if q == 1 -%}
                <span class="zn-perk zn-perk--off">+ {{ S.ship_fee }} de envío</span>
              {%- else -%}
                <span class="zn-perk">Envío gratis</span>
                <span class="zn-perk">Regalo: {{ S.gift_name }}</span>
                {%- if q > 2 -%}<span class="zn-perk">Tarjeta regalo</span>{%- endif -%}
                <span class="zn-perk zn-perk--save">Ahorras {% render 'zn-money', cents: save %}</span>
              {%- endif -%}
            </span>
            {%- if q > 1 -%}<span class="zn-offer__fine">{% render 'zn-money', cents: per %} por cojín · tachado: precio de {{ q }} sueltos</span>{%- endif -%}
          </label>
        {%- endfor -%}
      </div>
      <button type="submit" class="zn-btn" id="zn-cta">Comprar {{ sel.title }} · {% render 'zn-money', cents: sel.price %}</button>
      <ul class="zn-assure">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{{ S.trial_nights }} noches de prueba</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.8"/></svg>{{ S.pay_line }}</li>
      </ul>
    {%- endform -%}
  </section>

  <section class="zn-band">
    <div class="zn-in zn-narrow">
      <h2 class="zn-h2">{{ S.vs_title }}</h2>
      <div class="zn-pair">
        <figure>{% render 'zn-img', img: S.img_sin, label: 'FOTO 04 · Sin cojín: rodillas juntas, cadera torcida', ratio: '1/1', cls: 'zn-pair__img' %}<figcaption class="zn-tag zn-tag--rain">Sin cojín</figcaption></figure>
        <figure>{% render 'zn-img', img: S.img_con, label: 'FOTO 05 · Con cojín: rodillas separadas, cadera recta', ratio: '1/1', cls: 'zn-pair__img' %}<figcaption class="zn-tag zn-tag--sun">Con cojín</figcaption></figure>
      </div>
      <p class="zn-note">{{ S.forecast_con }}</p>
    </div>
  </section>

  <section class="zn-sec">
    <div class="zn-in zn-narrow zn-split">
      {% render 'zn-img', img: S.img_problem, label: 'FOTO 06 · Almohada normal caída en el suelo al amanecer', ratio: '4/3', cls: 'zn-split__img' %}
      <div>
        <h2 class="zn-h2">{{ S.signs_title }}</h2>
        <ul class="zn-signs">
          {%- for b in section.blocks -%}
            {%- if b.type == 'sign' -%}<li {{ b.shopify_attributes }}>{{ b.settings.text }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  <section class="zn-band zn-band--sea">
    <div class="zn-in">
      <h2 class="zn-h2">Cómo se usa</h2>
      <ol class="zn-steps">
        {%- assign n = 0 -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'step' -%}
            {%- assign n = n | plus: 1 -%}
            <li {{ b.shopify_attributes }}>
              {%- capture lbl -%}FOTO 0{{ n | plus: 6 }} · {{ b.settings.text }}{%- endcapture -%}
              {% render 'zn-img', img: b.settings.image, label: lbl, ratio: '1/1', cls: 'zn-steps__img' %}
              <span>{{ b.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </section>

  <section class="zn-sec">
    <div class="zn-in zn-narrow zn-split zn-split--rev">
      {% render 'zn-img', img: S.img_gift, label: 'FOTO 10 · Caja de regalo con tarjeta para los padres', ratio: '4/5', cls: 'zn-split__img' %}
      <div>
        <h2 class="zn-h2">{{ S.gift_title }}</h2>
        <p class="zn-short">{{ S.gift_text }}</p>
        <a class="zn-btn" href="#zn-comprar">{{ S.gift_cta }}</a>
      </div>
    </div>
  </section>

  <section class="zn-band">
    <div class="zn-in zn-narrow zn-split">
      {% render 'zn-img', img: S.img_cmp, label: 'FOTO 11 · Almohada normal aplastada junto al cojín Zentia', ratio: '4/3', cls: 'zn-split__img' %}
      <div>
        <h2 class="zn-h2">Almohada normal frente a Zentia</h2>
        <ul class="zn-vs">
          {%- for b in section.blocks -%}
            {%- if b.type == 'cmp' -%}<li {{ b.shopify_attributes }}><s>{{ b.settings.them }}</s><span>{{ b.settings.us }}</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  <section class="zn-guar">
    <div class="zn-in zn-narrow zn-guar__row">
      <svg class="zn-guar__moon" viewBox="0 0 96 96" aria-hidden="true"><circle cx="48" cy="48" r="44" fill="#0E5E6F"/><path d="M58 22a28 28 0 1 0 18 40 23 23 0 0 1-18-40z" fill="#F4C430"/></svg>
      <div><h2 class="zn-h2">{{ S.trial_nights }} noches de prueba</h2><p class="zn-short">{{ S.guarantee }}</p></div>
    </div>
  </section>

  <section class="zn-band">
    <div class="zn-in zn-narrow">
      <h2 class="zn-h2">Preguntas</h2>
      {%- for b in section.blocks -%}
        {%- if b.type == 'faq' -%}
          <details class="zn-faq" {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><p>{{ b.settings.a }}</p></details>
        {%- endif -%}
      {%- endfor -%}
      <p class="zn-empty">{{ S.reviews_empty }}</p>
    </div>
  </section>
</main>

<footer class="zn-foot">
  <div class="zn-in zn-narrow">
    {% render 'zn-logo' %}
    <p>{{ S.contact }}</p>
    <nav class="zn-legal" aria-label="Legal">
      {%- for p in shop.policies -%}<a href="{{ p.url }}">{{ p.title }}</a>{%- endfor -%}
    </nav>
  </div>
</footer>

<div class="zn-sticky" id="zn-sticky" aria-hidden="true">
  <div class="zn-in zn-sticky__row">
    <span class="zn-sticky__lbl"><span id="zn-s-t">{{ sel.title }}</span><b id="zn-s-p">{% render 'zn-money', cents: sel.price %}</b></span>
    <button type="submit" form="zn-form" class="zn-btn zn-btn--sm" tabindex="-1">Comprar</button>
  </div>
</div>

<script>
(function(){
  var cta=document.getElementById('zn-cta'),st=document.getElementById('zn-s-t'),sp=document.getElementById('zn-s-p');
  document.querySelectorAll('.zn-offer input').forEach(function(r){
    r.addEventListener('change',function(){
      cta.textContent='Comprar '+r.dataset.title+' · '+r.dataset.price;
      st.textContent=r.dataset.title; sp.textContent=r.dataset.price;
    });
  });
  var bar=document.getElementById('zn-sticky');
  function chk(){var rc=cta.getBoundingClientRect();var on=rc.bottom<0||rc.top>window.innerHeight;bar.classList.toggle('is-on',on);bar.setAttribute('aria-hidden',on?'false':'true');}
  window.addEventListener('scroll',chk,{passive:true});window.addEventListener('resize',chk);chk();
  var c=document.querySelector('.zn-count');
  if(c){
    var end=new Date(c.dataset.deadline).getTime(),out=c.querySelector('.zn-count__t');
    var tick=function(){
      var ms=end-Date.now();
      if(isNaN(end)||ms<=0){c.hidden=true;return;}
      var d=Math.floor(ms/864e5),h=Math.floor(ms%864e5/36e5),m=Math.floor(ms%36e5/6e4);
      out.textContent=(d>0?d+' d ':'')+h+' h '+m+' min';
    };
    tick();setInterval(tick,30000);
  }
})();
</script>

{% schema %}
{
  "name": "Zentia · ficha descanso",
  "settings": [
    { "type": "text", "id": "ship_short", "label": "Cabecera: envío", "default": "Envío 2–5 días" },
    { "type": "text", "id": "headline", "label": "Titular", "default": "Duerme de lado sin que las rodillas choquen" },
    { "type": "text", "id": "subhead", "label": "Subtítulo", "default": "Cojín de espuma viscoelástica para entre las rodillas." },
    { "type": "text", "id": "vs_title", "label": "Título sin/con", "default": "La diferencia, en una noche" },
    { "type": "text", "id": "forecast_con", "label": "Previsión con cojín", "default": "Con el cojín, rodillas separadas y cadera recta hasta que suene el despertador." },
    { "type": "text", "id": "signs_title", "label": "Título problema", "default": "¿Te suena?" },
    { "type": "text", "id": "gift_title", "label": "Título regalo", "default": "El regalo que van a usar cada noche" },
    { "type": "text", "id": "gift_text", "label": "Texto regalo", "default": "Con tarjeta para imprimir. Pide antes del 15-dic y llega antes de Nochebuena." },
    { "type": "text", "id": "gift_cta", "label": "Botón regalo", "default": "Regalar Para 3" },
    { "type": "text", "id": "guarantee", "label": "Garantía", "default": "Si no duermes más a gusto, te devolvemos el dinero." },
    { "type": "text", "id": "reviews_empty", "label": "Opiniones (sin reseñas)", "default": "Aún no hay opiniones: es nuevo en la tienda. Las primeras saldrán aquí tal cual." },
    { "type": "text", "id": "contact", "label": "Contacto", "default": "¿Dudas? Escríbenos y te contestamos en el día." },
    { "type": "text", "id": "stock_text", "label": "Aviso de stock (solo si es verdad)", "default": "Quedan pocas unidades en el almacén de España" },
    { "type": "text", "id": "ship_fee", "label": "Coste de envío de Para 1", "default": "4,95 €" },
    { "type": "text", "id": "gift_name", "label": "Regalo de los packs", "default": "guía de 7 noches (PDF)" },
    { "type": "text", "id": "deadline_label", "label": "Texto fecha límite", "default": "Pedidos para Nochebuena:" },
    { "type": "text", "id": "deadline_iso", "label": "Fecha límite real (ISO)", "default": "2026-12-15T23:59:00+01:00" },
    { "type": "text", "id": "trial_nights", "label": "Noches de prueba", "default": "60" },
    { "type": "text", "id": "note_1", "label": "Texto Para 1", "default": "solo para ti" },
    { "type": "text", "id": "note_2", "label": "Texto Para 2", "default": "para ti y tu pareja" },
    { "type": "text", "id": "tag_2", "label": "Etiqueta Para 2", "default": "Recomendado" },
    { "type": "text", "id": "note_3", "label": "Texto Para 3", "default": "y uno para tus padres" },
    { "type": "text", "id": "tag_3", "label": "Etiqueta Para 3", "default": "Para regalar" },
    { "type": "text", "id": "pay_line", "label": "Línea de pago", "default": "Tarjeta, Apple Pay o Google Pay" },
    { "type": "image_picker", "id": "img_hero", "label": "Foto 01 · portada" },
    { "type": "image_picker", "id": "img_pack", "label": "Foto 02 · pack de 2" },
    { "type": "image_picker", "id": "img_detail", "label": "Foto 03 · detalle" },
    { "type": "image_picker", "id": "img_sin", "label": "Foto 04 · sin cojín" },
    { "type": "image_picker", "id": "img_con", "label": "Foto 05 · con cojín" },
    { "type": "image_picker", "id": "img_problem", "label": "Foto 06 · el problema" },
    { "type": "image_picker", "id": "img_gift", "label": "Foto 10 · regalo" },
    { "type": "image_picker", "id": "img_cmp", "label": "Foto 11 · comparación" }
  ],
  "blocks": [
    { "type": "tick", "name": "Aviso de la barra", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis desde España" } ] },
    { "type": "sign", "name": "¿Te suena?", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Rodillas clavadas al despertar" } ] },
    { "type": "step", "name": "Paso", "settings": [
      { "type": "text", "id": "text", "label": "Texto", "default": "Paso" },
      { "type": "image_picker", "id": "image", "label": "Imagen del paso" } ] },
    { "type": "cmp", "name": "Comparación", "settings": [
      { "type": "text", "id": "them", "label": "Almohada normal", "default": "Plana" },
      { "type": "text", "id": "us", "label": "Zentia", "default": "Con forma de piernas" } ] },
    { "type": "faq", "name": "Pregunta", "settings": [
      { "type": "text", "id": "q", "label": "Pregunta", "default": "Pregunta" },
      { "type": "text", "id": "a", "label": "Respuesta", "default": "Respuesta" } ] }
  ]
}
{% endschema %}
