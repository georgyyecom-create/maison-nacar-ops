.zc-place{font-weight:500;color:#4A5066}.zc-rcard figcaption>.zc-ava,.zc-frev__top>.zc-ava{display:grid;font-size:17px;color:#fff}
.zc-rcard figcaption>span:not(.zc-ava){display:flex;flex-direction:column;font-size:15px;color:var(--zc-navy)}
.zc-rcard blockquote{margin:6px 0 0;font-size:16.5px;line-height:1.55;color:#2A3045}
/* cierre */
.zc-final-sub{text-align:center !important;max-width:420px;margin:0 auto}
/* pie */
.zc-foot{--zc-navy:#16244A;--zc-blue:#2F5BEA;background:#16244A;color:#C9D1E3;padding:40px 0 120px}
