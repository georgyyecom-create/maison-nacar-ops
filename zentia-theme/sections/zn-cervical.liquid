.zc-rsum__bars i{display:block;height:8px;border-radius:999px;background:linear-gradient(var(--zc-navy),var(--zc-navy)) left/var(--w) 100% no-repeat,#E3E7F0}
.zc-rgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:16px}.zc-rgrid:empty{display:none}
.zc-rgrid img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px}
.zc-rlist{display:grid;gap:0;margin-top:8px}
.zc-rcard{margin:0;padding:18px 0;border-bottom:1px solid #DDE3EF}
.zc-rcard figcaption{display:flex;align-items:center;gap:10px;margin-bottom:8px}
