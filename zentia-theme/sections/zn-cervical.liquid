.zc-why__it summary::-webkit-details-marker{display:none}
.zc-why__it summary:after{content:"+";position:absolute;right:0;top:12px;font-size:22px;color:var(--zc-blue)}
.zc-why__it[open] summary:after{content:"–"}
.zc-why__n{flex:none;width:28px;height:28px;border-radius:50%;background:var(--zc-navy);color:#fff;display:grid;place-items:center;font:800 14px/1 var(--zn-font)}
