.zc-price__note{flex-basis:100%;margin:0;font-size:14.5px;color:#4A5066}
.zc .zn-form .zn-btn.zc-card-btn{display:block;padding:0;min-height:62px;background:linear-gradient(180deg,#F4F7FF,#E6EEFF);color:var(--zc-navy);border:2px solid var(--zc-blue);box-shadow:0 0 0 4px rgba(47,91,234,.12),0 8px 20px -10px rgba(47,91,234,.6);text-transform:none;letter-spacing:0;position:relative}
.zc-cb{display:flex;align-items:center;gap:12px;width:100%;min-height:58px;padding:0 16px;text-align:left}
.zc-cb svg{flex:0 0 24px;width:24px;height:24px;fill:none;stroke:var(--zc-blue);stroke-width:1.8}
.zc-cb__t{flex:1;min-width:0;display:flex;flex-direction:column;font:800 17px/1.15 var(--zn-font)}
.zc-cb__t small{font:600 12.5px/1.2 var(--zn-font);color:#4A5066;margin-top:3px}
.zc-cb b{flex:none;font:800 18px/1 var(--zn-font)}
.zc-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border:0;margin:16px 0 0}
.zc-trust li{flex-direction:column;align-items:center;text-align:center;gap:6px;padding:12px 6px;border:1px solid #E3E7F0;border-radius:14px;background:#F8FAFE;font-size:13px;line-height:1.3}
.zc-trust li>span{flex:none}
.zc-trust b{display:block}
.zc-rate{overflow:hidden}.zc-rate__l{min-width:0}
.zc-rate__faces{flex:none;padding-left:8px}.zc-rate__faces img:first-child{margin-left:0}
.zc-frevs{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;margin:16px -16px 0;padding:0 16px 4px;scrollbar-width:none}
.zc-frevs::-webkit-scrollbar{display:none}
.zc-frevs .zc-frev{flex:0 0 100%;margin:0;scroll-snap-align:start}
.zc-frevs.is-many .zc-frev{flex-basis:86%}
.zc .zn-pk__nudge{display:none;background:#FFF6D6;border:1.5px solid #E9C46A;color:#5A4500}
.zc .zn-form:has(.zn-pk--one.is-on) .zn-pk__nudge{display:block;animation:zcpop .25s ease-out}
@keyframes zcpop{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.zc .zn-form:has(.zn-pk--one.is-on) .zn-pk__nudge{animation:none}}
