.zc-foot__nav{display:flex;flex-wrap:wrap;gap:10px 20px;padding:20px 0 0}
.zc-foot__nav a{color:#fff;font-size:15px;text-decoration:underline;text-underline-offset:3px;text-decoration-color:rgba(255,255,255,.35)}
.zc-foot__pay{display:flex;flex-wrap:wrap;gap:6px;margin:20px 0 0}
.zc-foot__pay .zn-pay__i{height:24px;width:auto;border-radius:4px;background:#fff}
.zc-foot__small{margin:16px 0 0;font-size:13px;line-height:1.5;color:#9AA5C0}
/* regalos de los packs: precio real tachado + «Gratis» */
.zc .zn-pk__li em.is-gift{text-transform:none;font-size:15px;letter-spacing:0;font-weight:800;color:#1E7A4D}
.zc .zn-pk__li em.is-gift s{font-weight:500;color:#8A90A0;margin-right:4px}
/* v3.3: puntitos blancos, icono tarjeta, foto tras desplegables */
@media (max-width:959px){.zc .zc-dots button{background:rgba(255,255,255,.55);box-shadow:0 0 0 1px rgba(22,36,74,.25),0 1px 3px rgba(0,0,0,.25)}.zc .zc-dots button.is-on{background:#fff}}
.zc .zn-form .zc-card-btn svg{display:block;flex:0 0 24px;width:24px;height:24px;margin:0;align-self:center}
