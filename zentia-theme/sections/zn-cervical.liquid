{%- liquid
  assign S = section.settings
  assign p2 = S.pack2_cents | default: 6990
  assign v1 = product.selected_or_first_available_variant
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign rv_n = 0
  assign rv_sum = 0
  for b in review_blocks
    assign rv_n = rv_n | plus: 1
    assign rv_sum = rv_sum | plus: b.settings.stars
  endfor
  assign rv_avg = ''
  if rv_n > 0
    assign rv_avg = rv_sum | times: 1.0 | divided_by: rv_n | round: 1
  endif
  assign rv_count = rv_n
  if S.rating_value != blank
    assign rv_avg = S.rating_value
  endif
  if S.rating_count != blank
    assign rv_count = S.rating_count
  endif
-%}

{% render 'zn-bar', text: S.bar_text, deadline: S.deadline_iso %}

<header class="zn-head">
  <div class="zn-in zn-head__row">
    {% render 'zn-logo', tagline: S.tagline %}
    <a class="zn-head__cart" href="{{ routes.cart_url }}" data-cart-open aria-label="Abrir carrito"><span class="zn-head__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l-1.2 12H6.2L5 7Z M9 7a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
    </a>
  </div>
</header>

<main class="zn-main zc">
  <section class="zn-pdp zn-in">
    <div class="zn-gal" data-gal>
      <div class="zn-gal__track" data-track tabindex="0" aria-label="Fotos del producto">
        {%- if product.media.size > 0 -%}
          {%- for m in product.media -%}
            {%- if m.media_type == 'image' -%}
              <figure class="zn-gal__slide">{%- if forloop.first -%}{{ m | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,800,1100,1400', sizes: '(min-width: 960px) 560px, 100vw' }}{%- else -%}{{ m | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width: 960px) 560px, 100vw' }}{%- endif -%}</figure>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'F01 · Portada con titular y 2 etiquetas', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'F02 · Mujer en el sofá con el masajeador', ratio: '1/1' %}</figure>
          <figure class="zn-gal__slide">{% render 'zn-img', label: 'F05 · Kit Cervical en caja regalo', ratio: '1/1' %}</figure>
        {%- endif -%}
      </div>
      <div class="zn-gal__thumbs zc-dots" data-thumbs aria-label="Elegir foto"></div>
    </div>

    <div class="zn-info">
      {%- if S.show_reviews and rv_avg != blank -%}
        <a class="zc-rate" href="#opiniones">
          <span class="zc-rate__l"><span class="zn-stars" style="--r: {{ rv_avg | replace: ',', '.' }}" aria-hidden="true">★★★★★</span><b>{{ rv_avg | replace: '.', ',' }}</b><small>/5</small><span class="zc-rate__n">{{ rv_count }} {{ S.rating_label | default: 'opiniones' }}</span></span>
          <span class="zc-rate__faces" aria-hidden="true">{%- for b in review_blocks limit: 5 -%}{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}{%- endfor -%}</span>
        </a>
      {%- endif -%}
      <h1 class="zn-title zc-title">{{ product.title }}</h1>
      <p class="zc-lead">{%- if S.pill != blank -%}<span class="zc-pill">{{ S.pill }}</span> {% endif -%}<b>{{ S.bullets_title }}</b></p>
      <ul class="zc-bul">
        {%- for b in section.blocks -%}{%- if b.type == 'bullet' -%}
          <li {{ b.shopify_attributes }}><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path d="m6 10.4 2.6 2.6L14 7.6"/></svg><span><b>{{ b.settings.lead }}</b> {{ b.settings.text }}</span></li>
        {%- endif -%}{%- endfor -%}
      </ul>
      <div class="zc-price">
        {%- assign kper = p2 | divided_by: 2 -%}{%- assign koff = v1.price | minus: kper | times: 100.0 | divided_by: v1.price | round -%}
        <span class="zc-price__b">{% render 'zn-money', cents: kper %}<small>/ud</small></span>
        <s class="zc-price__s">{% render 'zn-money', cents: v1.price %}</s>
        <span class="zc-price__pill">−{{ koff }} % en el kit</span>
        <p class="zc-price__note">Precio por masajeador en el Kit Cervical: 2 unidades, regalos y envío gratis.</p>
      </div>

      <div class="zn-offer zc-offer" id="oferta">
        {%- form 'product', product, id: 'zn-form', class: 'zn-form' -%}
          <input type="hidden" name="return_to" value="/checkout">
          {% render 'zn-packs-m', product: product, s: S %}
          {% render 'zn-cod', product: product, s: S, part: 'btn' %}
          <p class="zc-or">o, si prefieres pagar ya</p>
          <button type="submit" class="zn-btn zn-btn--buy zc-card-btn" data-buy>
            <span class="zc-cb"><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/></svg><span class="zc-cb__t">{{ S.cta }}<small>Pago seguro y al instante</small></span><b data-buy-price>{% render 'zn-money', cents: p2 %}</b></span>
          </button>
        {%- endform -%}
        <div class="zn-pay"><div class="zn-pay__icons">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'zn-pay__i' }}{%- endfor -%}</div></div>
        <ul class="zc-trust">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span data-eta data-min="{{ S.eta_min }}" data-max="{{ S.eta_max }}"><b>Llega entre</b> <span data-eta-a>—</span> y <span data-eta-b>—</span></span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg><span><b>Pagas al recibirlo</b> en efectivo</span></li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.3 2.3 4.2-4.6"/></svg><span><b>30 días</b> de prueba</span></li>
        </ul>
        {%- if S.wa_number != blank -%}<a class="zn-wa-line" href="https://wa.me/{{ S.wa_number }}?text={{ S.wa_text | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z"/></svg><span>¿Dudas? <b>Escríbenos por WhatsApp</b></span></a>{%- endif -%}
      </div>

      {%- if S.show_reviews and review_blocks.size > 0 -%}
        {%- assign nfeat = 0 -%}{%- for b in review_blocks -%}{%- if b.settings.featured -%}{%- assign nfeat = nfeat | plus: 1 -%}{%- endif -%}{%- endfor -%}
        <div class="zc-frevs{% if nfeat > 1 %} is-many{% endif %}">
          {%- for fr in review_blocks -%}
            {%- if nfeat == 0 and forloop.index > 1 -%}{%- break -%}{%- endif -%}
            {%- if nfeat > 0 and fr.settings.featured != true -%}{%- continue -%}{%- endif -%}
            <a class="zc-frev" href="#opiniones">
              <span class="zc-frev__top">{%- if fr.settings.image != blank -%}{{ fr.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span class="zc-ava">{{ fr.settings.name | slice: 0 }}</span>{%- endif -%}<span><b>{{ fr.settings.name }}{%- if fr.settings.place != blank -%}<span class="zc-place">, {{ fr.settings.place }}</span>{%- endif -%}</b><small>Compra verificada</small></span><span class="zn-stars zn-stars--s" style="--r: {{ fr.settings.stars }}" aria-label="{{ fr.settings.stars }} de 5">★★★★★</span></span>
              <q>{{ fr.settings.text | truncate: 170 }}</q>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="zc-cards">
        {%- for b in section.blocks -%}{%- if b.type == 'card' -%}
          <details class="zc-card" {{ b.shopify_attributes }} {% if forloop.first %}open{% endif %}><summary>{{ b.settings.title }}</summary><div class="zn-rte">{{ b.settings.body }}</div></details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  <section class="zc-photo zn-in">
    <div class="zc-photo__img">{% render 'zn-img', img: S.img_after, label: 'Foto tras los desplegables', ratio: '4/5' %}</div>
  </section>

  <section class="zc-sec zc-sec--tint">
    <div class="zn-in zc-narrow">
      <h2 class="zc-h2">{{ S.suena_title }}</h2>
      <p class="zc-p">{{ S.suena_text }}</p>
      <div class="zc-why__img">{% render 'zn-img', img: S.img_why, label: '3D · cervical con la zona de la nuca cargada', ratio: '1/1' %}</div>
      <div class="zc-why">
        {%- assign wn = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'suena' -%}{%- assign wn = wn | plus: 1 -%}
          <details class="zc-why__it" {{ b.shopify_attributes }} {% if wn == 1 %}open{% endif %}>
            <summary><span class="zc-why__n">{{ wn }}</span><b>{{ b.settings.title }}</b></summary>
            <div class="zc-why__body">
              <p><b>Por qué pasa:</b> {{ b.settings.text }}</p>
              {%- if b.settings.help != blank -%}<p><b>Cómo te ayuda Zentia:</b> {{ b.settings.help }}</p>{%- endif -%}
            </div>
          </details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  <section class="zc-sec">
    <div class="zn-in zc-narrow">
      <h2 class="zc-h2">{{ S.test_title }}</h2>
      <p class="zc-p zc-center">{{ S.test_text }}</p>
      <div class="zc-test" data-ztest>
        <p class="zc-test__kg"><b data-zkg>27</b><span>kg</span></p>
        <p class="zc-test__txt" data-ztxt>Mirando el móvil con la cabeza muy inclinada.</p>
        <input type="range" min="0" max="4" step="1" value="4" aria-label="Inclinación de la cabeza" data-zr>
        <div class="zc-test__ticks"><span>0°</span><span>15°</span><span>30°</span><span>45°</span><span>60°</span></div>
        <p class="zc-src">{{ S.test_source }}</p>
      </div>
    </div>
  </section>

  <section class="zc-sec zc-sec--tint">
    <div class="zn-in zc-split">
      <div class="zc-split__img">{% render 'zn-img', img: S.img_how, label: '3D · el masajeador en la nuca: 6 cabezales y calor', ratio: '4/5' %}</div>
      <div>
        <h2 class="zc-h2 zc-left">{{ S.how_title }}</h2>
        <div class="zc-p zn-rte">{{ S.how_text }}</div>
        <ul class="zc-feat">{%- assign fn = 0 -%}
          {%- for b in section.blocks -%}{%- if b.type == 'feature' -%}{%- assign fn = fn | plus: 1 -%}
            <li {{ b.shopify_attributes }}><span class="zc-feat__i" aria-hidden="true">{%- case fn -%}{%- when 1 -%}<svg viewBox="0 0 24 24"><path d="M12 21c-3.6 0-6-2.4-6-5.6 0-3.2 2.6-4.6 3.4-8.4 2.5 1.6 3.2 3.7 3 5.6 1-.6 1.7-1.7 1.9-3 1.6 1.4 3.7 3.4 3.7 5.9 0 3.2-2.4 5.5-6 5.5Z"/></svg>{%- when 2 -%}<svg viewBox="0 0 24 24"><path d="M2 12h4l2.5-6 4 12 3-9 1.8 3H22"/></svg>{%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="8"/><path d="M12 13 15.5 8.5M8 4.5h8"/></svg>{%- endcase -%}</span><span><b>{{ b.settings.title }}</b><small>{{ b.settings.text }}</small></span></li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- if S.show_steps -%}
  <section class="zc-sec">
    <div class="zn-in">
      <h2 class="zc-h2">{{ S.steps_title }}</h2>
      <p class="zc-p zc-center">{{ S.steps_text }}</p>
      <ol class="zc-steps">
        {%- assign n = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'step' -%}{%- assign n = n | plus: 1 -%}
          <li {{ b.shopify_attributes }}>
            <div class="zc-steps__img">{% render 'zn-img', img: b.settings.image, label: b.settings.label, ratio: '1/1' %}<span>{{ n }}</span></div>
            <b>{{ b.settings.title }}</b>
            <small>{{ b.settings.text }}</small>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>
  {%- endif -%}

  {%- assign moments = section.blocks | where: 'type', 'moment' -%}
  {%- if moments.size > 0 -%}
  <section class="zc-sec">
    <div class="zn-in">
      <h2 class="zc-h2">{{ S.mom_title }}</h2>
      <p class="zc-p">{{ S.mom_text }}</p>
      <div class="zc-mom">
        {%- for b in moments -%}
          <figure class="zc-mom__c" {{ b.shopify_attributes }}>
            <div class="zc-mom__img">{% render 'zn-img', img: b.settings.image, label: b.settings.label, ratio: '4/5' %}</div>
            <figcaption><b>{{ b.settings.title }}</b><small>{{ b.settings.text }}</small></figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <section class="zc-sec zc-sec--tint">
    <div class="zn-in zc-narrow">
      <h2 class="zc-h2">{{ S.cmp_title }}</h2>
      <p class="zc-p">{{ S.calc_text }}</p>
      {%- assign per2 = p2 | divided_by: 2 -%}
      <div class="zc-calc" data-zcalc data-session="{{ S.calc_session }}" data-own="{{ per2 }}">
        <label class="zc-calc__q" for="zc-calc-r">¿Cuántas veces al mes irías a un masaje?</label>
        <div class="zc-calc__in"><input id="zc-calc-r" type="range" min="1" max="8" step="1" value="2" data-zcr><output for="zc-calc-r" data-zco>2</output></div>
        <div class="zc-calc__bar is-them"><span>En un centro, en un año</span><b data-zct>—</b><i data-zcw1></i></div>
        <div class="zc-calc__bar is-us"><span>Tu masajeador en el kit, una sola vez</span><b>{% render 'zn-money', cents: per2 %}</b><i data-zcw2></i></div>
        <p class="zc-src">Calculado con {{ S.calc_session }} € por sesión, lo más bajo de lo que suele costar un masaje de cuello y espalda.</p>
      </div>
      <ul class="zc-vs">
        {%- for b in section.blocks -%}{%- if b.type == 'row' -%}
          <li {{ b.shopify_attributes }}><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path d="m6 10.4 2.6 2.6L14 7.6"/></svg><span><b>{{ b.settings.us }}</b><small>En un centro: {{ b.settings.other | downcase }}</small></span></li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>

  {%- if S.show_reviews and review_blocks.size > 0 -%}
  {%- assign c5 = 0 -%}{%- assign c4 = 0 -%}{%- assign c3 = 0 -%}{%- assign c2 = 0 -%}{%- assign c1 = 0 -%}
  {%- for b in review_blocks -%}{%- case b.settings.stars -%}{%- when 5 -%}{%- assign c5 = c5 | plus: 1 -%}{%- when 4 -%}{%- assign c4 = c4 | plus: 1 -%}{%- when 3 -%}{%- assign c3 = c3 | plus: 1 -%}{%- when 2 -%}{%- assign c2 = c2 | plus: 1 -%}{%- else -%}{%- assign c1 = c1 | plus: 1 -%}{%- endcase -%}{%- endfor -%}
  <section class="zc-sec" id="opiniones">
    <div class="zn-in zc-narrow">
      <h2 class="zc-h2">{{ S.rev_title }}</h2>
      <div class="zc-rsum">
        <div class="zc-rsum__n"><b>{{ rv_avg | replace: '.', ',' }}</b><span class="zn-stars" style="--r: {{ rv_avg | replace: ',', '.' }}" aria-hidden="true">★★★★★</span><small>{{ rv_count }} opiniones</small></div>
        {%- if S.dist_5 != blank -%}{%- assign c5 = S.dist_5 | plus: 0 -%}{%- assign c4 = S.dist_4 | plus: 0 -%}{%- assign c3 = S.dist_3 | plus: 0 -%}{%- assign c2 = S.dist_2 | plus: 0 -%}{%- assign c1 = S.dist_1 | plus: 0 -%}{%- assign ctot = c5 | plus: c4 | plus: c3 | plus: c2 | plus: c1 | at_least: 1 -%}<ul class="zc-rsum__bars" aria-label="Reparto de estrellas">
          {%- assign cs = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
          {%- for c in cs -%}{%- assign st = 6 | minus: forloop.index -%}{%- assign pct = c | times: 100 | divided_by: ctot -%}<li><span>{{ st }} ★</span><i style="--w: {{ pct }}%"></i><span>{{ c }}</span></li>{%- endfor -%}
        </ul>{%- endif -%}
      </div>
      {%- assign photos = '' -%}
      <div class="zc-rgrid">
        {%- for b in review_blocks -%}{%- if b.settings.photo != blank -%}{{ b.settings.photo | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Foto de cliente' }}{%- endif -%}{%- endfor -%}
      </div>
      <p class="zc-rnote">{{ S.rev_note }}</p>
      <div class="zc-rlist">
        {%- for b in review_blocks limit: 12 -%}
          <figure class="zc-rcard" {{ b.shopify_attributes }}>
            <figcaption>{%- if b.settings.image != blank -%}{{ b.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span class="zc-ava">{{ b.settings.name | slice: 0 }}</span>{%- endif -%}<span><b>{{ b.settings.name }}{%- if b.settings.place != blank -%}<span class="zc-place">, {{ b.settings.place }}</span>{%- endif -%}</b><small>Compra verificada</small></span></figcaption>
            <span class="zn-stars zn-stars--s" style="--r: {{ b.settings.stars }}" aria-label="{{ b.settings.stars }} de 5">★★★★★</span>
            <blockquote>{{ b.settings.text }}</blockquote>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <section class="zc-sec">
    <div class="zn-in zc-split zc-split--rev">
      <div class="zc-split__img">{% render 'zn-img', img: S.img_gift, label: 'F10 · Regalo de Navidad a su madre', ratio: '1/1' %}</div>
      <div>
        <h2 class="zc-h2 zc-left">{{ S.gift_title }}</h2>
        <div class="zc-p zn-rte">{{ S.gift_text }}</div>
        <a class="zn-btn zn-btn--buy zc-btn" href="#oferta" data-pick="1">{{ S.gift_cta }}</a>
      </div>
    </div>
  </section>

  <section class="zc-sec zc-sec--navy">
    <div class="zn-in zc-narrow zc-guar">
      <div class="zc-guar__seal" aria-hidden="true"><b>{{ S.nights }}</b><span>días</span></div>
      <h2 class="zc-h2">{{ S.guar_title }}</h2>
      <p class="zc-p">{{ S.guar_text }}</p>
    </div>
  </section>

  <section class="zc-sec">
    <div class="zn-in zc-narrow">
      <h2 class="zc-h2">{{ S.faq_title }}</h2>
      <div class="zc-cards">
        {%- for b in section.blocks -%}{%- if b.type == 'faq' -%}
          <details class="zc-card" {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><div class="zn-rte">{{ b.settings.a }}</div></details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  <section class="zc-sec zc-sec--tint">
    <div class="zn-in zc-narrow zc-center">
      <h2 class="zc-h2">{{ S.final_title }}</h2>
      <p class="zc-p zc-final-sub">{{ S.final_text }}</p>
      <a class="zn-btn zn-btn--buy zc-btn" href="#oferta" data-pick="1">{{ S.final_cta }} · {% render 'zn-money', cents: p2 %}</a>
    </div>
  </section>
</main>

<footer class="zc-foot">
  <div class="zn-in">
    <div class="zc-foot__top">
      {% render 'zn-logo', tagline: S.tagline %}
      {%- if S.wa_number != blank -%}<a class="zc-foot__wa" href="https://wa.me/{{ S.wa_number }}?text={{ S.wa_text | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z"/></svg>Escríbenos por WhatsApp</a>{%- endif -%}
    </div>
    <ul class="zc-foot__facts">
      <li><b>Envío desde España</b>MRW, 2–4 días laborables</li>
      <li><b>Pago al recibirlo</b>En efectivo, o con tarjeta</li>
      <li><b>30 días de prueba</b>Y 14 de desistimiento por ley</li>
    </ul>
    <nav class="zc-foot__nav" aria-label="Información legal">
      {%- for p in shop.policies -%}<a href="{{ p.url }}">{{ p.title }}</a>{%- endfor -%}
    </nav>
    <div class="zc-foot__pay">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'zn-pay__i' }}{%- endfor -%}</div>
    <p class="zc-foot__small">{{ S.foot_note }}</p>
    <p class="zc-foot__small">© {{ 'now' | date: '%Y' }} Zentia · zentiadescanso.com</p>
  </div>
</footer>

<div class="zn-sticky" data-sticky aria-hidden="true">
  <div class="zn-sticky__txt"><b>{{ S.sticky_title }}</b><span data-sticky-price>{% render 'zn-money', cents: p2 %}</span></div>
  <a class="zn-btn zn-btn--buy zn-btn--sm" href="#oferta" tabindex="-1">{{ S.cta_sticky }}</a>
</div>

