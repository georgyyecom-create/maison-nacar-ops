.zc .zn-pk__name b{font-size:17px}.zc .zn-pk__gifts{white-space:nowrap}.zc .zn-pk__top{grid-template-columns:auto 52px 1fr auto;gap:8px}.zc .zn-pk__img{width:52px;height:52px;background:#fff;border:1px solid #E3E7F0}.zc .zn-pk__img img{object-fit:contain}
@media (max-width:959px){.zc .zc-dots{position:static;padding:10px 0 0;justify-content:center}.zc .zc-dots button{background:#C9D1E3;box-shadow:none}.zc .zc-dots button.is-on{background:var(--zc-navy)}}
