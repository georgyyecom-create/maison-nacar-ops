<script>
(function(){
  var t=document.querySelector('[data-ztest]');if(!t)return;
  var kg=[5,12,18,22,27],tx=['Con la cabeza recta, el cuello sostiene unos 5 kg.','Mirando un poco hacia abajo: unos 12 kg.','Leyendo o con el ordenador bajo: unos 18 kg.','Con el móvil en el sofá: unos 22 kg.','Con la cabeza muy inclinada: hasta 27 kg.'];
  var r=t.querySelector('[data-zr]'),k=t.querySelector('[data-zkg]'),x=t.querySelector('[data-ztxt]');
  var up=function(){var i=+r.value;k.textContent=kg[i];x.textContent=tx[i];r.style.setProperty('--p',(i*25)+'%');};
  r.addEventListener('input',up);up();
})();
(function(){
  var c=document.querySelector('[data-zcalc]');if(!c)return;
  var ses=+c.dataset.session||30,own=(+c.dataset.own||3495)/100,r=c.querySelector('[data-zcr]'),o=c.querySelector('[data-zco]'),t=c.querySelector('[data-zct]'),w1=c.querySelector('[data-zcw1]'),w2=c.querySelector('[data-zcw2]');
  var fm=function(n){return n.toLocaleString('es-ES',{maximumFractionDigits:0})+' €';};
  var up=function(){var n=+r.value,y=n*12*ses;o.textContent=n;t.textContent=fm(y);w1.style.width='100%';w2.style.width=Math.max(3,own/y*100)+'%';r.style.setProperty('--p',((n-1)/7*100)+'%');};
  r.addEventListener('input',up);up();
})();
</script>

