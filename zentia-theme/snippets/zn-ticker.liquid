{%- doc -%}
  Franja de confianza que va rotando mensajes cortos (uno a la vez).
  @param {string} text - Mensajes separados por « · »
{%- enddoc -%}
{%- assign extra = 'Llega en 2–4 días desde España|60 noches de prueba' -%}
<div class="zn-tick" data-tick aria-live="off">
  <ul class="zn-tick__list">
    {%- assign base = text | split: ' · ' -%}
    {%- assign more = extra | split: '|' -%}
    {%- assign all = base | concat: more -%}
    {%- for it in all -%}
      <li class="zn-tick__it{% if forloop.first %} is-on{% endif %}"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9"/><path d="m6 10.4 2.6 2.6L14 7.6"/></svg>{{ it | strip }}</li>
    {%- endfor -%}
  </ul>
</div>
