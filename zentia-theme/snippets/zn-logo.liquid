{%- doc -%}
  Marca de texto de Zentia: nombre en serif con espaciado y lema pequeño.
  @param {string} [tagline] - Lema bajo el nombre
{%- enddoc -%}
<a class="zn-brand" href="{{ request.path }}" aria-label="Zentia">
  <span class="zn-brand__name">ZENTIA</span>
  <span class="zn-brand__tag">{{ tagline | default: 'Descanso y postura' }}</span>
</a>
