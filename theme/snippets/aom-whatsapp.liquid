{%- comment -%}
  Maison Nácar · Botón de WhatsApp flotante.
  Número y textos en Configuración del tema → WhatsApp. En una ficha de producto el mensaje incluye el nombre de la pieza.
{%- endcomment -%}
{%- liquid
  assign wa = settings.aom_wa_number | remove: ' ' | remove: '+' | remove: '-'
  if template.name == 'product' and product
    assign msg = settings.aom_wa_msg_product | default: 'Hola, tengo una duda sobre' | append: ' «' | append: product.title | append: '».'
  else
    assign msg = settings.aom_wa_msg | default: 'Hola, tengo una duda sobre Maison Nácar.'
  endif
-%}
{%- if wa != blank and settings.aom_wa_show -%}
<a class="aom-wa" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 6.9L3 29l6.5-2c1.9 1 4.1 1.6 6.5 1.6 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.3c-2.1 0-4.1-.6-5.8-1.7l-.4-.3-3.9 1.2 1.2-3.8-.3-.4a10.4 10.4 0 0 1-1.7-5.7C5.1 10 10 5.3 16 5.3S26.9 10 26.9 15.8 22 26.3 16 26.3zm6-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.4 3.4c.2.2 2.4 3.6 5.7 5 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.7-.4z"/></svg>
  <span class="aom-wa__t"><b>{{ settings.aom_wa_label | default: '¿Dudas? Escríbenos' }}</b>{%- if settings.aom_wa_hours != blank -%}<small>{{ settings.aom_wa_hours }}</small>{%- endif -%}</span>
</a>
{%- endif -%}
