{%- comment -%} Tarjeta de reseña · la usa la sección «Reseñas AOM» {%- endcomment -%}
<article class="aom-rv" {{ attrs }}>
  {%- if photo -%}<div class="aom-rv__ph">{{ photo | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '300px', alt: '' }}</div>{%- endif -%}
  <div class="aom-rv__b">
    {% render 'aom-stars', rating: stars, size: 14 %}
    {%- if text != blank -%}<p class="aom-rv__t">{{ text | newline_to_br }}</p>{%- endif -%}
    <p class="aom-rv__who">{{ name }}{% if place != blank %}, {{ place }}{% endif %}
      <span>{%- if verified -%}<span class="aom-rv__ok">✓ Clienta verificada</span>{%- elsif source != blank -%}{{ source }}{%- endif -%}</span>
    </p>
    {%- if show_prod and prod -%}<a class="aom-rv__prod" href="{{ prod.url }}">{%- if prod.featured_image -%}{{ prod.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}{{ prod.title }}</a>{%- endif -%}
  </div>
</article>
