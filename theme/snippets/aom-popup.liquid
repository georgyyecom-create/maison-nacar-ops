{%- comment -%}
  Maison Nácar · Pop-up pequeño del 3x2 (tarjeta abajo, nunca a pantalla completa).
  Juego: tocas 3 cajitas → salen 3 joyas → la 3.ª lleva «GRATIS». Debajo: canal de WhatsApp y email.
  Se configura en Configuración del tema → Maison Nácar → Pop-up 3x2.
{%- endcomment -%}
{%- liquid
  assign wa = settings.aom_wa_number | remove: ' ' | remove: '+' | remove: '-'
  assign show = settings.aom_pop_show
  if template.name == 'cart' or template.name == 'password'
    assign show = false
  endif
  assign chan = settings.aom_wa_channel
  if chan == blank and wa != blank
    assign chan = 'https://wa.me/' | append: wa | append: '?text=Hola%2C%20quiero%20que%20me%20avis%C3%A9is%20del%20Black%20Friday%20y%20las%20novedades%20%E2%9C%A8'
  endif
  assign pp = settings.aom_pop_products
-%}
{%- if show -%}
<div class="aom-pop" data-aom-pop hidden data-delay="{{ settings.aom_pop_delay | default: 18 }}" data-days="{{ settings.aom_pop_days | default: 7 }}"{% if request.design_mode and settings.aom_pop_preview %} data-preview{% endif %}>
  <div class="aom-pop__box" tabindex="-1" role="dialog" aria-modal="false" aria-labelledby="aom-pop-t">
    <button type="button" class="aom-pop__x" data-aom-pop-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <p class="aom-pop__k">{% render 'aom-camp', k: 'kicker' %}</p>
    <p class="aom-pop__t" id="aom-pop-t">{{ settings.aom_pop_title }}</p>
    <div class="aom-pop__game" data-aom-game>
      {%- assign gn = 0 -%}
      {%- for gp in pp limit: 3 -%}
        {%- assign gn = gn | plus: 1 -%}
        <button type="button" class="aom-pop__gift" data-aom-gift-box aria-label="Abrir cajita {{ gn }}">
          <span class="aom-pop__lid" aria-hidden="true">
            <svg viewBox="0 0 48 48"><rect x="9" y="20" width="30" height="21" rx="1"/><rect x="7" y="14" width="34" height="7" rx="1"/><path d="M24 14v27M24 14c-3-6-10-6.5-10-2 0 2.6 5 2 10 2zm0 0c3-6 10-6.5 10-2 0 2.6-5 2-10 2z"/></svg>
          </span>
          <span class="aom-pop__in">
            {%- if gp and gp.featured_image -%}{{ gp.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: gp.title }}{%- else -%}<span class="aom-pop__ph">✦</span>{%- endif -%}
            <em>{% if forloop.last %}Regalo{% else %}{{ gp.price | money_without_trailing_zeros }}{% endif %}</em>
          </span>
        </button>
      {%- endfor -%}
    </div>
    <p class="aom-pop__won" data-aom-won hidden>{{ settings.aom_pop_won }}</p>
    <a class="aom-pop__cta" href="{{ settings.aom_pop_link | default: '/pages/3x2' }}" data-aom-pop-go>{{ settings.aom_pop_btn }} →</a>
    <div class="aom-pop__more">
      {%- if chan != blank -%}
        <a class="aom-pop__wa" href="{{ chan }}" target="_blank" rel="noopener" data-aom-pop-join>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 6.9L3 29l6.5-2c1.9 1 4.1 1.6 6.5 1.6 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm6.9 17.7c-.3.8-1.7 1.6-2.4 1.7-.6.1-1.4.1-2.2-.1-.5-.2-1.2-.4-2-.8-3.5-1.5-5.8-5-6-5.3-.2-.2-1.4-1.9-1.4-3.6s.9-2.5 1.2-2.9c.3-.3.7-.4.9-.4h.7c.2 0 .5-.1.8.6.3.7 1 2.4 1.1 2.6.1.2.1.4 0 .6-.1.2-.2.4-.3.6l-.5.5c-.2.2-.3.4-.1.7.2.4.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.4.2.6.1.8-.1.2-.2.9-1 1.1-1.4.2-.4.5-.3.8-.2.3.1 2 .9 2.4 1.1.4.2.6.3.7.4.1.3.1.9-.2 1.7z"/></svg>
          <span>{{ settings.aom_pop_channel_text }}</span>
        </a>
      {%- endif -%}
      {%- if settings.aom_pop_email -%}
        {%- form 'customer', id: 'aom-pop-form', class: 'aom-pop__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup-3x2">
          <label class="visually-hidden" for="aom-pop-email">Email</label>
          <input id="aom-pop-email" type="email" name="contact[email]" placeholder="O déjanos tu email" autocomplete="email" required>
          <button type="submit">Avisadme</button>
          {%- if form.posted_successfully? -%}<span data-aom-pop-ok hidden></span>{%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
    <p class="aom-pop__ok" data-aom-pop-done hidden>¡Hecho! Te avisaremos antes que a nadie ✨</p>
  </div>
</div>
<script>
  (function () {
    var pop = document.querySelector('[data-aom-pop]'); if (!pop) return;
    var KEY = 'aomPop3x2', now = Date.now(), days = +pop.getAttribute('data-days') || 7;
    function get() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } }
    function set(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }
    var st = get(), ok = pop.querySelector('[data-aom-pop-ok]');
    function blocked() {
      if (document.body.classList.contains('aom-lock')) return true;
      var ck = document.getElementById('shopify-pc__banner');
      if (ck) { var cs = getComputedStyle(ck), r = ck.getBoundingClientRect(); if (cs.display !== 'none' && cs.visibility !== 'hidden' && +cs.opacity > 0 && r.height > 0) return true; }
      return false;
    }
    function open() {
      if (!pop.hidden || blocked()) return false;
      pop.hidden = false; requestAnimationFrame(function () { pop.classList.add('is-on'); });
      document.body.classList.add('aom-pop-on');
      return true;
    }
    function close() { pop.classList.remove('is-on'); document.body.classList.remove('aom-pop-on'); setTimeout(function () { pop.hidden = true; }, 300); if (!get().joined) set({ seen: Date.now() }); }
    function done() { set({ joined: 1 }); var d = pop.querySelector('[data-aom-pop-done]'); if (d) d.hidden = false; var m = pop.querySelector('.aom-pop__more'); if (m) m.hidden = true; }
    pop.querySelectorAll('[data-aom-pop-close]').forEach(function (b) { b.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) close(); });
    var j = pop.querySelector('[data-aom-pop-join]'); if (j) j.addEventListener('click', function () { setTimeout(done, 400); });
    var g = pop.querySelector('[data-aom-pop-go]'); if (g) g.addEventListener('click', function () { set({ seen: Date.now() }); });
    /* Juego de las 3 cajitas */
    var opened = 0;
    pop.querySelectorAll('[data-aom-gift-box]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (b.classList.contains('is-open')) return;
        b.classList.add('is-open'); opened++;
        if (opened === 3) { pop.classList.add('is-won'); pop.querySelector('[data-aom-won]').hidden = false; }
      });
    });
    if (ok) { open(); done(); return; }
    if (pop.hasAttribute('data-preview')) { open(); return; }
    if (st.joined || (st.seen && now - st.seen < days * 864e5)) return;
    var fired = false, start = Date.now(), minWait = 8000;
    function trigger() { if (fired) return; if (Date.now() - start < minWait) return; if (open()) { fired = true; cleanup(); } }
    var t = setInterval(function () { if (Date.now() - start >= (+pop.getAttribute('data-delay') || 18) * 1000) trigger(); }, 1000);
    function onScroll() { var h = document.documentElement.scrollHeight - innerHeight; if (h > 0 && scrollY / h > 0.5) trigger(); }
    function onOut(e) { if (!e.relatedTarget && e.clientY <= 0) trigger(); }
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('mouseout', onOut);
    function cleanup() { clearInterval(t); window.removeEventListener('scroll', onScroll); document.removeEventListener('mouseout', onOut); }
  })();
</script>
{%- endif -%}
