{%- comment -%}
  Maison Nácar · Tarjeta de conjunto 3x2 (estética v17).
  Uso: {% render 'aom-setcard', items: block.settings.products, title: block.settings.title, image: block.settings.image, note: block.settings.note %}
  Si no hay foto del conjunto puesto, compone las 3 piezas sobre marfil (proporciones fijas: nunca se estiran).
{%- endcomment -%}
{%- liquid
  assign full = 0
  assign cheap = 999999999
  assign ids = ''
  assign n = 0
  for p in items limit: 3
    assign v = p.selected_or_first_available_variant
    for x in p.variants
      assign xt = x.title | downcase
      if x.available and xt contains 'gold'
        assign v = x
        break
      endif
    endfor
    if v.available
      assign n = n | plus: 1
      assign full = full | plus: v.price
      if v.price < cheap
        assign cheap = v.price
      endif
      assign ids = ids | append: v.id | append: ','
    endif
  endfor
  assign total = full | minus: cheap
  assign first = items | first
  assign url = first.url | append: '?pack=3'
-%}
{%- if n == 3 -%}
<article class="aom-set3">
  <a class="aom-set3__media" href="{{ url }}" aria-label="{{ title | escape }}">
    {%- if image -%}
      <span class="aom-set3__photo">{{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 45vw, 92vw', alt: title }}</span>
    {%- else -%}
      <span class="aom-set3__trio">
        {%- for p in items limit: 3 -%}
          <span class="aom-set3__cell aom-set3__cell--{{ forloop.index }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 25vw, 50vw', alt: p.title }}{%- endif -%}</span>
        {%- endfor -%}
      </span>
    {%- endif -%}
  </a>
  <div class="aom-set3__body">
    <h3 class="aom-set3__t"><a href="{{ url }}">{{ title }}</a></h3>
    <p class="aom-set3__items">{% for p in items limit: 3 %}{{ p.title }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p>
    <p class="aom-set3__p"><b>{{ total | money_without_trailing_zeros }}</b><s>{{ full | money_without_trailing_zeros }}</s><span>La 3.ª, de regalo</span></p>
    {%- if note != blank -%}<p class="aom-set3__note">{{ note }}</p>{%- endif -%}
    <div class="aom-set3__btns">
      <a class="aom-btn" href="{{ url }}">Ver el conjunto</a>
      <button type="button" class="aom-link aom-set3__add" data-aom-addset="{{ ids }}">Añadir los 3 a la cesta</button>
    </div>
  </div>
</article>
{%- endif -%}
