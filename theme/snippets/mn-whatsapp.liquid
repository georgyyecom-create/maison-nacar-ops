{%- comment -%} Botón flotante de WhatsApp (número en Configuración del tema → Maison Nácar → WhatsApp) {%- endcomment -%}
{%- liquid
  assign wa = settings.aom_wa_number | remove: ' ' | remove: '+' | remove: '-'
  if template.name == 'product' and product
    assign msg = settings.aom_wa_msg_product | default: 'Hola, tengo una duda sobre' | append: ' «' | append: product.title | append: '».'
  else
    assign msg = settings.aom_wa_msg | default: 'Hola, tengo una duda sobre Maison Nácar.'
  endif
-%}
{%- if wa != blank and settings.aom_wa_show -%}
<a class="mn-wa" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 6.9L3 29l6.5-2c1.9 1 4.1 1.6 6.5 1.6 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm6.9 17.7c-.3.8-1.7 1.6-2.4 1.7-.6.1-1.4.1-2.2-.1-.5-.2-1.2-.4-2-.8-3.5-1.5-5.8-5-6-5.3-.2-.2-1.4-1.9-1.4-3.6s.9-2.5 1.2-2.9c.3-.3.7-.4.9-.4h.7c.2 0 .5-.1.8.6.3.7 1 2.4 1.1 2.6.1.2.1.4 0 .6-.1.2-.2.4-.3.6l-.5.5c-.2.2-.3.4-.1.7.2.4.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.4.2.6.1.8-.1.2-.2.9-1 1.1-1.4.2-.4.5-.3.8-.2.3.1 2 .9 2.4 1.1.4.2.6.3.7.4.1.3.1.9-.2 1.7z"/></svg>
</a>
{%- endif -%}
