{%- comment -%}
  Así queda puesto / Así se lleva. En una ficha salen primero las fotos del producto con «#puesto»
  y se completa hasta 3 con las fotos comunes de esta sección.
  Si no hay ninguna, se ven los huecos de esta sección (para las fotos de Gemini).
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign own = ''
  if product and S.use_product
    for m in product.media
      assign ma = m.alt | downcase
      if ma contains '#puesto' and m.media_type == 'image'
        assign own = own | append: forloop.index0 | append: ','
      endif
    endfor
  endif
  assign own_list = own | split: ','
-%}
<style>
  #mn-w-{{ section.id }} .w-grid { display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0 var(--mn-gutter); }
  #mn-w-{{ section.id }} .w-grid::-webkit-scrollbar { display: none; }
  #mn-w-{{ section.id }} .w-grid > * { scroll-snap-align: center; }
  @media (min-width: 990px) { #mn-w-{{ section.id }} .w-grid { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); max-width: var(--mn-max); margin: 0 auto; padding: 0 var(--mn-gutter); } }
  #mn-w-{{ section.id }} figure { margin: 0; }
  #mn-w-{{ section.id }} figcaption { margin-top: 8px; font-size: 14px; }
</style>
<section id="mn-w-{{ section.id }}" class="mn-sec">
  <div class="mn-wrap mn-head"><div><h2 class="mn-h2">{{ S.title }}</h2>{%- if S.text != blank -%}<p>{{ S.text }}</p>{%- endif -%}</div></div>
  <div class="w-grid">
    {%- if own_list.size > 0 -%}
      {%- assign shown = 0 -%}
      {%- for i in own_list limit: 3 -%}
        {%- assign widx = i | plus: 0 -%}
        {%- assign m = product.media[widx] -%}
        {%- assign shown = shown | plus: 1 -%}
        <figure><span class="mn-ph" style="aspect-ratio: 4/5">{{ m.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 78vw', alt: product.title }}</span></figure>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if shown < 3 and block.settings.image != blank -%}
          {%- assign shown = shown | plus: 1 -%}
          <figure {{ block.shopify_attributes }}>{% render 'mn-ph', image: block.settings.image, ratio: '4/5', n: block.settings.n, label: block.settings.label, sizes: '(min-width: 990px) 33vw, 78vw' %}{%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}</figure>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>{% render 'mn-ph', image: block.settings.image, ratio: '4/5', n: block.settings.n, label: block.settings.label, sizes: '(min-width: 990px) 33vw, 78vw' %}{%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}</figure>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Así queda puesto",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Así queda puesto" },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "use_product", "label": "En fichas, usar las fotos del producto con «#puesto»", "default": true }
  ],
  "blocks": [
    { "type": "photo", "name": "Foto", "settings": [
      { "type": "image_picker", "id": "image", "label": "Foto (4:5)" },
      { "type": "text", "id": "n", "label": "Número del hueco", "default": "05" },
      { "type": "text", "id": "label", "label": "Qué foto va aquí", "default": "POV: la joya puesta" },
      { "type": "text", "id": "caption", "label": "Pie de foto" }
    ] }
  ],
  "presets": [ { "name": "Así queda puesto" } ]
}
{% endschema %}
