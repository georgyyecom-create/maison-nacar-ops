{%- comment -%}
  Tu estuche (página /pages/3x2): el estuche fijo arriba se llena al tocar «+».
  Con 3 joyas, la de menor precio sale como regalo. El descuento real lo aplica el 3x2 automático.
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign plist = S.collection.products
  if S.collection == blank or S.collection.products.size == 0
    assign plist = collections.all.products
  endif
-%}
<style>
  #mn-b-{{ section.id }} .b-top { padding: 28px 0 0; }
  #mn-b-{{ section.id }} .b-top p { margin: 10px 0 0; color: var(--mn-grey); max-width: 44ch; }
  #mn-b-{{ section.id }} .b-box { margin: 18px 0 20px; }
  #mn-b-{{ section.id }} .b-mini { position: fixed; z-index: 45; left: 10px; right: 10px; bottom: 10px; display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 10px; border-radius: 18px; background: var(--mn-ink); color: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.25); transform: translateY(140%); visibility: hidden; transition: transform .3s var(--mn-ease), visibility 0s linear .3s; }
  #mn-b-{{ section.id }} .b-mini.is-on { transform: none; visibility: visible; transition: transform .3s var(--mn-ease); }
  #mn-b-{{ section.id }} .b-mini .mn-slots { flex: none; width: 128px; gap: 4px; }
  #mn-b-{{ section.id }} .b-mini .mn-slot { border-radius: 8px; }
  #mn-b-{{ section.id }} .b-mini .mn-slot__name, #mn-b-{{ section.id }} .b-mini .mn-slot__plus { display: none; }
  #mn-b-{{ section.id }} .b-mini__t { flex: 1; min-width: 0; font-size: 13px; line-height: 1.25; }
  #mn-b-{{ section.id }} .b-mini__t b { display: block; font-size: 16px; }
  #mn-b-{{ section.id }} .b-mini .mn-btn { flex: none; min-height: 44px; padding: 0 16px; background: #fff; color: var(--mn-ink); border-color: #fff; font-size: 14px; }
  @media (min-width: 990px) { #mn-b-{{ section.id }} .b-box { position: sticky; z-index: 20; } #mn-b-{{ section.id }} .b-mini { display: none; } }
  body.mn-mini-on .mn-wa { bottom: 84px; }
  @media (min-width: 990px) { #mn-b-{{ section.id }} .b-wrap { display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: start; } #mn-b-{{ section.id }} .b-box { top: 92px; order: 2; margin-top: 28px; } }
  #mn-b-{{ section.id }} .b-box .mn-btn { margin-top: 12px; background: #fff; color: var(--mn-ink); border-color: #fff; min-height: 50px; }
  #mn-b-{{ section.id }} .b-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 10px; margin-top: 16px; }
  @media (min-width: 750px) { #mn-b-{{ section.id }} .b-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  #mn-b-{{ section.id }} .b-it[hidden] { display: none; }
  #mn-b-{{ section.id }} .b-cols { display: flex; gap: 6px; margin-top: 8px; }
  #mn-b-{{ section.id }} .b-col { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 1px solid var(--mn-line); border-radius: 50%; background: #fff; cursor: pointer; }
  #mn-b-{{ section.id }} .b-col.is-on { border-color: var(--mn-ink); box-shadow: inset 0 0 0 2px #fff; }
  #mn-b-{{ section.id }} .b-it.is-in .mn-card__add { background: var(--mn-ink); color: #fff; }
</style>
<section id="mn-b-{{ section.id }}" data-mn-builder>
  <div class="mn-wrap">
    <div class="b-top">
      <h1 class="mn-h1" style="font-size: clamp(44px, 12vw, 96px)">{{ S.title }}</h1>
      <p>{{ S.text }}</p>
    </div>
    <div class="b-wrap">
      <div class="b-box">
        <div class="mn-box">
          <p class="mn-box__h"><b data-b-h>Tu estuche</b><span>{% render 'aom-camp', k: 'short' %}</span></p>
          <div class="mn-slots" data-b-slots></div>
          <div class="mn-box__sum"><span data-b-l>0 joyas</span><span><s data-b-full></s><b data-b-tot></b></span></div>
          <p class="mn-box__note" data-b-note></p>
          <button type="button" class="mn-btn mn-btn--block" data-b-go disabled>Elige 3 joyas</button>
        </div>
      </div>
      <div>
        <div class="mn-pills" data-b-tabs>
          <button type="button" class="mn-pill is-on" data-t="">Todas</button>
          <button type="button" class="mn-pill" data-t="collar">Collares</button>
          <button type="button" class="mn-pill" data-t="pulsera">Pulseras</button>
          <button type="button" class="mn-pill" data-t="pendiente">Pendientes</button>
          <button type="button" class="mn-pill" data-t="anillo">Anillos</button>
        </div>
        <div class="b-grid">
          {%- for p in plist limit: 60 -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              for x in p.variants
                assign xt = x.title | downcase
                if x.available and xt contains 'gold'
                  assign v = x
                  break
                endif
              endfor
              assign sv = nil
              for x in p.variants
                assign xt = x.title | downcase
                if x.available and xt contains 'silver'
                  assign sv = x
                  break
                endif
              endfor
              assign vt = v.title | downcase
            -%}
            {%- if v.available -%}
              <div class="mn-card b-it" data-b-it data-type="{{ p.type | downcase }}" data-v="{{ v.id }}" data-p="{{ v.price }}" data-k="{% if v.compare_at_price > v.price %}{{ v.compare_at_price }}{% else %}0{% endif %}" data-n="{{ p.title | escape }}" data-img="{% if v.featured_image %}{{ v.featured_image | image_url: width: 400 }}{% else %}{{ p.featured_image | image_url: width: 400 }}{% endif %}">
                <a class="mn-card__media" href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 22vw, 46vw', alt: p.title }}{%- endif -%}</a>
                <button type="button" class="mn-card__add" data-b-add aria-label="Añadir {{ p.title | escape }} al estuche">{% render 'mn-icon', i: 'plus' %}</button>
                <div class="mn-card__body"><a class="mn-card__t" href="{{ p.url }}">{{ p.title }}</a>{% render 'mn-price', v: v %}</div>
                {%- if sv and vt contains 'gold' -%}
                  <div class="b-cols">
                    {%- for cv in p.variants -%}{%- assign ct = cv.title | downcase -%}{%- if cv.id == v.id or cv.id == sv.id -%}
                      <button type="button" class="b-col{% if cv.id == v.id %} is-on{% endif %}" data-b-col data-v="{{ cv.id }}" data-p="{{ cv.price }}" data-k="{% if cv.compare_at_price > cv.price %}{{ cv.compare_at_price }}{% else %}0{% endif %}" data-c="{% if ct contains 'silver' %}Plateado{% else %}Dorado{% endif %}" data-img="{% if cv.featured_image %}{{ cv.featured_image | image_url: width: 400 }}{% else %}{{ p.featured_image | image_url: width: 400 }}{% endif %}" aria-label="{% if ct contains 'silver' %}Plateado{% else %}Dorado{% endif %}"><i class="mn-dot mn-dot--{% if ct contains 'silver' %}silver{% else %}gold{% endif %}"></i></button>
                    {%- endif -%}{%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  <div class="b-mini" data-b-mini aria-hidden="true">
    <div class="mn-slots" data-b-mini-slots></div>
    <p class="b-mini__t"><b data-b-mini-tot></b><span data-b-mini-l></span></p>
    <button type="button" class="mn-btn" data-b-mini-go tabindex="-1">Añadir</button>
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('mn-b-{{ section.id }}'); if (!root) return;
    var picks = [];
    var PLUS = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
    var CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
    function q(s) { return root.querySelector(s); }
    function paint() {
      if (!window.MN) return;
      var u = picks.map(function (x) { return { name: x.n, img: x.img, price: x.p, ref: Math.max(x.k || 0, x.p), on: true, el: x.el }; });
      var full = u.reduce(function (a, x) { return a + x.price; }, 0), ref = u.reduce(function (a, x) { return a + x.ref; }, 0), gift = null;
      if (u.length === 3) { gift = u.reduce(function (a, x) { return x.price <= a.price ? x : a; }); gift.gift = true; }
      q('[data-b-slots]').innerHTML = MN.slotsHTML(u, { buttons: true, prices: true });
      q('[data-b-full]').textContent = (gift || ref > full) ? MN.money(ref) : '';
      q('[data-b-tot]').textContent = MN.money(full - (gift ? gift.price : 0));
      q('[data-b-l]').textContent = u.length === 1 ? '1 joya' : u.length + ' joyas';
      q('[data-b-h]').textContent = u.length === 3 ? 'Estuche completo' : 'Tu estuche';
      q('[data-b-note]').textContent = gift ? 'Te regalamos ' + gift.name + '. Toca un hueco para cambiarlo.' : (u.length === 2 ? 'Elige la tercera: la de menor precio es tu regalo.' : 'Elige 3 joyas: la de menor precio es tu regalo.');
      var go = q('[data-b-go]'); go.disabled = u.length === 0; go.textContent = u.length === 3 ? 'Añadir el estuche' : (u.length ? 'Añadir ' + u.length + (u.length === 1 ? ' joya' : ' joyas') + ' · faltan ' + (3 - u.length) : 'Elige 3 joyas');
      root.querySelectorAll('[data-b-it]').forEach(function (it) { var n = picks.filter(function (x) { return x.el === it; }).length; it.classList.toggle('is-in', n > 0); it.querySelector('[data-b-add]').innerHTML = n > 1 ? '<b style="font-size:14px">×' + n + '</b>' : (n ? CHECK : PLUS); });
      q('[data-b-mini-slots]').innerHTML = MN.slotsHTML(u);
      q('[data-b-mini-tot]').textContent = MN.money(full - (gift ? gift.price : 0));
      q('[data-b-mini-l]').textContent = u.length === 3 ? 'Estuche completo' : u.length + ' de 3 · la 3.ª, regalo';
      syncMini();
    }
    var mini = q('[data-b-mini]'), bigBox = q('.b-box'), boxVisible = true;
    function syncMini() { var on = picks.length > 0 && !boxVisible; mini.classList.toggle('is-on', on); mini.setAttribute('aria-hidden', on ? 'false' : 'true'); q('[data-b-mini-go]').tabIndex = on ? 0 : -1; document.body.classList.toggle('mn-mini-on', on); }
    if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { boxVisible = es[0].isIntersecting; syncMini(); }).observe(bigBox);
    q('[data-b-mini-go]').addEventListener('click', function () { q('[data-b-go]').click(); });
    root.addEventListener('click', function (e) {
      var a = e.target.closest('[data-b-add]');
      if (a) { var it = a.closest('[data-b-it]'), on = it.querySelector('[data-b-col].is-on'), snap = { el: it, v: it.getAttribute('data-v'), p: +it.getAttribute('data-p'), k: +it.getAttribute('data-k') || 0, img: it.getAttribute('data-img'), n: it.getAttribute('data-n') + (on && on.getAttribute('data-c') === 'Plateado' ? ' · plateado' : '') }; if (picks.length < 3) picks.push(snap); else picks[2] = snap; paint(); return; }
      var col = e.target.closest('[data-b-col]');
      if (col) { var ci = col.closest('[data-b-it]'); ci.querySelectorAll('[data-b-col]').forEach(function (b) { b.classList.toggle('is-on', b === col); }); ['data-v', 'data-p', 'data-k', 'data-img'].forEach(function (k) { ci.setAttribute(k, col.getAttribute(k)); }); var ck = +col.getAttribute('data-k') || 0, cp = +col.getAttribute('data-p'); ci.querySelector('.mn-card__p').innerHTML = (ck > cp ? '<s>' + MN.money(ck) + '</s> ' : '') + MN.money(cp); var im = ci.querySelector('.mn-card__media img'); if (im) { im.removeAttribute('srcset'); im.src = col.getAttribute('data-img'); } return; }
      var s = e.target.closest('[data-mn-slot]');
      if (s) { picks.splice(+s.getAttribute('data-mn-slot'), 1); paint(); return; }
      var t = e.target.closest('[data-b-tabs] button');
      if (t) { root.querySelectorAll('[data-b-tabs] button').forEach(function (x) { x.classList.toggle('is-on', x === t); }); var k = t.getAttribute('data-t'); root.querySelectorAll('[data-b-it]').forEach(function (it) { it.hidden = !!k && it.getAttribute('data-type').indexOf(k) < 0; }); }
    });
    q('[data-b-go]').addEventListener('click', function () {
      var go = this; go.classList.add('is-busy');
      var q = {}; picks.forEach(function (x) { q[x.v] = (q[x.v] || 0) + 1; }); MN.add(Object.keys(q).map(function (v) { return { id: +v, quantity: q[v] }; })).then(function () { picks = []; go.classList.remove('is-busy'); paint(); }, function () { go.classList.remove('is-busy'); });
    });
    if (window.MN) paint(); else window.addEventListener('DOMContentLoaded', paint);
  })();
</script>
{% schema %}
{
  "name": "Tu estuche (3x2)",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Tu estuche" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Elige 3 joyas y la de menor precio es nuestro regalo. Llega en su estuche, con envío gratis." },
    { "type": "collection", "id": "collection", "label": "Joyas", "info": "Si está vacía o no está publicada, se muestran todas." }
  ],
  "presets": [ { "name": "Tu estuche (3x2)" } ]
}
{% endschema %}
