{%- comment -%}
  Maison Nácar · Arma tu 3x2 (página /pages/3x2)
  3 huecos fijos arriba: al tocar «+» en una joya se llena un hueco. Con 3, la de menor precio sale GRATIS.
  El descuento real lo hace el descuento automático de Shopify «3x2: elige 3, paga 2».
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign sets = section.blocks | where: 'type', 'set'
  assign plist = S.collection.products
  if S.collection == blank or S.collection.products.size == 0
    assign plist = collections.all.products
  endif
-%}
<style>
  #aom-b-{{ section.id }} { padding: 18px 0 120px; }
  #aom-b-{{ section.id }} .b-top { text-align: center; padding: 0 16px; max-width: 700px; margin: 0 auto; }
  #aom-b-{{ section.id }} h1 { font-family: var(--aom-serif); font-weight: 400; font-size: clamp(34px, 7vw, 58px); line-height: 1.03; margin: 10px 0 0; }
  #aom-b-{{ section.id }} h1 em { font-style: italic; color: var(--aom-accent); }
  #aom-b-{{ section.id }} .b-top p { margin: 8px 0 0; color: var(--aom-muted); font-size: 15px; line-height: 1.5; }
  #aom-b-{{ section.id }} .b-bar { position: sticky; top: calc(var(--aom-hdr-h, 64px) + 4px); z-index: 5; max-width: 560px; margin: 16px auto 0; padding: 12px; border-radius: 20px; background: rgba(255,255,255,.96); box-shadow: 0 10px 30px rgba(18,17,16,.12); backdrop-filter: blur(6px); }
  #aom-b-{{ section.id }} .b-bar .aom-slots { grid-template-columns: repeat(3, 64px) 1fr; align-items: center; }
  #aom-b-{{ section.id }} .b-bar .aom-slot { font-size: 18px; border-radius: 12px; }
  #aom-b-{{ section.id }} .b-bar .aom-slot__tag { font-size: 9.5px; padding: 2px 6px; bottom: 3px; }
  #aom-b-{{ section.id }} .b-sum { padding-left: 6px; font-size: 13px; line-height: 1.35; }
  #aom-b-{{ section.id }} .b-sum b { font-size: 17px; }
  #aom-b-{{ section.id }} .b-sum s { color: var(--aom-muted); margin-left: 4px; }
  #aom-b-{{ section.id }} .b-go { width: 100%; margin-top: 10px; min-height: 48px; }
  #aom-b-{{ section.id }} .b-go[disabled] { opacity: .45; cursor: default; }
  #aom-b-{{ section.id }} h2 { font-family: var(--aom-serif); font-weight: 400; font-size: 28px; margin: 36px 0 14px; text-align: center; }
  #aom-b-{{ section.id }} .b-sets { display: grid; gap: 14px; }
  @media (min-width: 750px) { #aom-b-{{ section.id }} .b-sets { grid-template-columns: repeat(2, 1fr); } }
  #aom-b-{{ section.id }} .b-tabs { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px; }
  #aom-b-{{ section.id }} .b-tabs button { min-height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--aom-line); background: #fff; font: inherit; font-size: 13px; cursor: pointer; }
  #aom-b-{{ section.id }} .b-tabs button.is-on { background: var(--aom-ink); color: #fff; border-color: var(--aom-ink); }
  #aom-b-{{ section.id }} .b-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (min-width: 750px) { #aom-b-{{ section.id }} .b-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
  #aom-b-{{ section.id }} .b-it { position: relative; border-radius: 16px; background: #fff; border: 1px solid var(--aom-line); overflow: hidden; }
  #aom-b-{{ section.id }} .b-it[hidden] { display: none; }
  #aom-b-{{ section.id }} .b-it img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; mix-blend-mode: multiply; background: var(--aom-ivory); }
  #aom-b-{{ section.id }} .b-it a { color: inherit; text-decoration: none; }
  #aom-b-{{ section.id }} .b-it p { margin: 8px 10px 0; font-size: 13px; line-height: 1.3; min-height: 34px; }
  #aom-b-{{ section.id }} .b-it .pr { display: flex; align-items: center; justify-content: space-between; padding: 6px 10px 10px; }
  #aom-b-{{ section.id }} .b-it .pr b { font-size: 15px; }
  #aom-b-{{ section.id }} .b-add { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--aom-ink); background: #fff; font-size: 20px; line-height: 1; cursor: pointer; }
  #aom-b-{{ section.id }} .b-it.is-on { border-color: var(--aom-ink); box-shadow: inset 0 0 0 1px var(--aom-ink); }
  #aom-b-{{ section.id }} .b-it.is-on .b-add { background: var(--aom-ink); color: #fff; }
</style>
<section id="aom-b-{{ section.id }}" data-aom-builder>
  <div class="aom-container">
    <div class="b-top">
      <span class="aom-sticker aom-sticker--red">{% render 'aom-camp', k: 'kicker' %}</span>
      <h1>{{ S.title }}</h1>
      {%- if S.text != blank -%}<p>{{ S.text }}</p>{%- endif -%}
    </div>

    <div class="b-bar">
      <div class="aom-slots">
        <span class="aom-slot" data-b-slot>1</span><span class="aom-slot" data-b-slot>2</span><span class="aom-slot" data-b-slot><span class="aom-slot__q">🎁</span></span>
        <span class="b-sum" data-b-sum>Elige <b>3 joyas</b>: la de menor precio, gratis.</span>
      </div>
      <button type="button" class="aom-btn b-go" data-b-go disabled>Elige 3 joyas</button>
    </div>

    {%- if sets.size > 0 -%}
      <h2>{{ S.sets_title }}</h2>
      <div class="b-sets">
        {%- for block in sets -%}
          <div {{ block.shopify_attributes }}>{% render 'aom-setcard', items: block.settings.products, title: block.settings.title, badge: block.settings.badge, image: block.settings.image, add: true %}</div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <h2>{{ S.grid_title }}</h2>
    <div class="b-tabs" data-b-tabs>
      <button type="button" class="is-on" data-t="">Todo</button>
      <button type="button" data-t="collares">Collares</button>
      <button type="button" data-t="pulseras">Pulseras</button>
      <button type="button" data-t="pendientes">Pendientes</button>
      <button type="button" data-t="anillos">Anillos</button>
    </div>
    <div class="b-grid">
      {%- if plist.size > 0 -%}
        {%- for p in plist limit: 60 -%}
          {%- liquid
            assign v = p.selected_or_first_available_variant
            for x in p.variants
              assign xt = x.title | downcase
              if x.available and xt contains 'gold'
                assign v = x
                break
              endif
            endfor
          -%}
          {%- if v.available -%}
            <div class="b-it" data-b-it data-type="{{ p.type | downcase }}" data-v="{{ v.id }}" data-price="{{ v.price }}" data-img="{{ p.featured_image | image_url: width: 160 }}">
              <a href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 400, 500', sizes: '(min-width: 750px) 25vw, 50vw', alt: p.title }}{%- endif -%}<p>{{ p.title }}</p></a>
              <div class="pr"><b>{{ v.price | money }}</b><button type="button" class="b-add" data-b-add aria-label="Elegir {{ p.title | escape }}">+</button></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
  <script type="application/json" data-b-money>{{ shop.money_format | json }}</script>
</section>
<script>
  (function () {
    var root = document.querySelector('#aom-b-{{ section.id }}'); if (!root) return;
    var MF = JSON.parse(root.querySelector('[data-b-money]').textContent), AMT = /\{\{\s*amount[a-z_]*\s*\}\}/;
    function money(c) { var n = (c / 100).toFixed(2); if (/comma/.test(MF)) n = n.replace('.', ','); return MF.replace(AMT, n).replace(/<[^>]*>/g, ''); }
    var picks = [], slots = root.querySelectorAll('[data-b-slot]'), sum = root.querySelector('[data-b-sum]'), go = root.querySelector('[data-b-go]');
    function paint() {
      root.querySelectorAll('[data-b-it]').forEach(function (it) { it.classList.toggle('is-on', picks.indexOf(it) > -1); it.querySelector('[data-b-add]').textContent = picks.indexOf(it) > -1 ? '✓' : '+'; });
      var prices = picks.map(function (it) { return +it.getAttribute('data-price'); }), full = prices.reduce(function (a, b) { return a + b; }, 0);
      var cheap = picks.length === 3 ? Math.min.apply(null, prices) : -1, freeDone = false;
      slots.forEach(function (s, i) {
        var it = picks[i], fr = it && !freeDone && +it.getAttribute('data-price') === cheap;
        if (fr) freeDone = true;
        s.classList.toggle('is-on', !!it); s.classList.toggle('is-free', !!fr);
        s.innerHTML = it ? '<img src="' + it.getAttribute('data-img') + '" alt="">' + (fr ? '<span class="aom-slot__tag">GRATIS</span>' : '') : (i === 2 ? '<span class="aom-slot__q">🎁</span>' : String(i + 1));
      });
      if (picks.length < 3) {
        sum.innerHTML = picks.length ? 'Te faltan <b>' + (3 - picks.length) + '</b>' + (picks.length === 2 ? ': ¡la 3.ª puede ser gratis!' : '') : 'Elige <b>3 joyas</b>: la de menor precio, gratis.';
        go.disabled = true; go.textContent = 'Elige ' + (3 - picks.length) + (3 - picks.length === 1 ? ' joya más' : ' joyas más');
      } else {
        sum.innerHTML = 'Tus 3: <b>' + money(full - cheap) + '</b><s>' + money(full) + '</s><br>Te ahorras ' + money(cheap);
        go.disabled = false; go.textContent = 'Añadir mis 3 a la cesta';
      }
    }
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-b-add]');
      if (b) { var it = b.closest('[data-b-it]'), i = picks.indexOf(it); if (i > -1) picks.splice(i, 1); else if (picks.length < 3) picks.push(it); paint(); return; }
      var t = e.target.closest('[data-b-tabs] button');
      if (t) { root.querySelectorAll('[data-b-tabs] button').forEach(function (x) { x.classList.toggle('is-on', x === t); }); var k = t.getAttribute('data-t'); root.querySelectorAll('[data-b-it]').forEach(function (it) { it.hidden = k && it.getAttribute('data-type').indexOf(k) < 0; }); return; }
    });
    go.addEventListener('click', function () {
      var items = picks.map(function (it) { return { id: +it.getAttribute('data-v'), quantity: 1 }; });
      go.disabled = true;
      var p = window.AOMCart ? window.AOMCart.add(items) : fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) }).then(function () { location.href = '/cart'; });
      p.then(function () { picks = []; paint(); }, function () { paint(); });
    });
    paint();
  })();
</script>
{% schema %}
{
  "name": "Arma tu 3x2",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Arma tu <em>3x2</em>" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Elige 3 joyas: la de menor precio te sale gratis. Envío gratis y estuche de regalo." },
    { "type": "text", "id": "sets_title", "label": "Título de los conjuntos", "default": "O llévate un conjunto ya hecho" },
    { "type": "text", "id": "grid_title", "label": "Título de las joyas", "default": "Todas las joyas" },
    { "type": "collection", "id": "collection", "label": "Joyas que se pueden elegir" }
  ],
  "blocks": [
    {
      "type": "set", "name": "Conjunto",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Conjunto" },
        { "type": "product_list", "id": "products", "label": "Las 3 piezas (la más barata, la última)", "limit": 3 },
        { "type": "text", "id": "badge", "label": "Etiqueta" },
        { "type": "image_picker", "id": "image", "label": "Foto del conjunto puesto (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "Arma tu 3x2" } ]
}
{% endschema %}
