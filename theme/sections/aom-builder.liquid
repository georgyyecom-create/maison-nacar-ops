{%- comment -%}
  Maison Nácar · Elige tus 3 joyas (página /pages/3x2)
  Barra fija con 3 huecos: al tocar «+» en una joya se llena un hueco. Con 3, la de menor precio es un regalo.
  El descuento real lo aplica el descuento automático de Shopify «3x2: elige 3, paga 2».
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign plist = S.collection.products
  if S.collection == blank or S.collection.products.size == 0
    assign plist = collections.all.products
  endif
-%}
<style>
  #aom-b-{{ section.id }} { padding: 36px 0 64px; background: var(--aom-ivory); }
  #aom-b-{{ section.id }} .b-tray { position: sticky; top: calc(var(--aom-hdr-sticky, 64px) + 8px); z-index: 5; max-width: 620px; margin: 0 auto 32px; padding: 14px; background: #fff; border: 1px solid var(--aom-line); box-shadow: 0 10px 30px rgba(18,17,16,.08); }
  #aom-b-{{ section.id }} .b-row { display: grid; grid-template-columns: repeat(3, 60px) minmax(0, 1fr); gap: 8px; align-items: center; }
  @media (min-width: 750px) { #aom-b-{{ section.id }} .b-row { grid-template-columns: repeat(3, 72px) minmax(0, 1fr); gap: 10px; } }
  #aom-b-{{ section.id }} .b-slot { position: relative; display: block; width: 100%; padding-bottom: 100%; border: 1px dashed rgba(18,17,16,.25); background: var(--aom-ivory); }
  #aom-b-{{ section.id }} .b-slot > * { position: absolute; inset: 0; }
  #aom-b-{{ section.id }} .b-slot .n { display: grid; place-items: center; font-family: var(--aom-serif); font-size: 22px; color: var(--aom-muted); }
  #aom-b-{{ section.id }} .b-slot img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transform: scale(1.25); }
  #aom-b-{{ section.id }} .b-slot.is-on { border-style: solid; border-color: var(--aom-ink); }
  #aom-b-{{ section.id }} .b-slot .g { top: auto; padding: 2px 0; background: var(--aom-ink); color: #fff; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; text-align: center; }
  #aom-b-{{ section.id }} .b-sum { padding-left: 6px; font-size: 13px; line-height: 1.4; color: var(--aom-muted); }
  #aom-b-{{ section.id }} .b-sum b { color: var(--aom-ink); font-weight: 600; }
  #aom-b-{{ section.id }} .b-sum .t { display: block; color: var(--aom-ink); font-size: 19px; font-weight: 500; line-height: 1.2; }
  #aom-b-{{ section.id }} .b-sum s { font-size: 12.5px; color: var(--aom-muted); }
  #aom-b-{{ section.id }} .b-go { width: 100%; margin-top: 12px; }
  #aom-b-{{ section.id }} .b-go[disabled] { opacity: .35; cursor: default; }
  #aom-b-{{ section.id }} .b-tabs { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin: 0 0 24px; }
  #aom-b-{{ section.id }} .b-tabs button { padding: 0 0 4px; border: 0; border-bottom: 1px solid transparent; background: none; font: inherit; font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--aom-muted); cursor: pointer; }
  #aom-b-{{ section.id }} .b-tabs button.is-on { color: var(--aom-ink); border-color: var(--aom-ink); }
  #aom-b-{{ section.id }} .b-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  @media (min-width: 750px) { #aom-b-{{ section.id }} .b-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 20px; } }
  #aom-b-{{ section.id }} .b-it[hidden] { display: none; }
  #aom-b-{{ section.id }} .b-media { position: relative; display: block; padding-bottom: 100%; background: var(--aom-ivory); overflow: hidden; }
  #aom-b-{{ section.id }} .b-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transform: scale(1.18); }
  #aom-b-{{ section.id }} .b-add { position: absolute; right: 8px; bottom: 8px; display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--aom-ink); border-radius: 50%; background: #fff; color: var(--aom-ink); cursor: pointer; }
  #aom-b-{{ section.id }} .b-add svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  #aom-b-{{ section.id }} .b-it.is-on .b-media { outline: 1px solid var(--aom-ink); outline-offset: -1px; }
  #aom-b-{{ section.id }} .b-it.is-on .b-add { background: var(--aom-ink); color: #fff; }
  #aom-b-{{ section.id }} .b-name { display: block; margin: 12px 0 0; font-size: 14px; line-height: 1.35; color: var(--aom-ink); text-decoration: none; }
  #aom-b-{{ section.id }} .b-price { margin: 4px 0 0; font-size: 14px; color: var(--aom-muted); }
</style>
<section id="aom-b-{{ section.id }}" data-aom-builder>
  <div class="aom-container">
    <div class="aom-head">
      <p class="aom-kicker">{% render 'aom-camp', k: 'kicker' %} · 3x2</p>
      <h1 class="aom-h2">{{ S.title }}</h1>
      {%- if S.text != blank -%}<p>{{ S.text }}</p>{%- endif -%}
    </div>

    <div class="b-tray">
      <div class="b-row">
        <span class="b-slot" data-b-slot><span class="n">1</span></span>
        <span class="b-slot" data-b-slot><span class="n">2</span></span>
        <span class="b-slot" data-b-slot><span class="n">3</span></span>
        <span class="b-sum" data-b-sum></span>
      </div>
      <button type="button" class="aom-btn b-go" data-b-go disabled>Elige 3 joyas</button>
    </div>

    <div class="b-tabs" data-b-tabs>
      <button type="button" class="is-on" data-t="">Todas</button>
      <button type="button" data-t="collar">Collares</button>
      <button type="button" data-t="pulsera">Pulseras</button>
      <button type="button" data-t="pendiente">Pendientes</button>
      <button type="button" data-t="anillo">Anillos</button>
    </div>
    <div class="b-grid">
      {%- for p in plist limit: 60 -%}
        {%- liquid
          assign v = p.selected_or_first_available_variant
          for x in p.variants
            assign xt = x.title | downcase
            if x.available and xt contains 'gold'
              assign v = x
              break
            endif
          endfor
        -%}
        {%- if v.available -%}
          <div class="b-it" data-b-it data-type="{{ p.type | downcase }}" data-v="{{ v.id }}" data-price="{{ v.price }}" data-img="{{ p.featured_image | image_url: width: 200 }}">
            <a class="b-media" href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 400, 500', sizes: '(min-width: 750px) 25vw, 50vw', alt: p.title }}{%- endif -%}</a>
            <button type="button" class="b-add" data-b-add aria-label="Elegir {{ p.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            <a class="b-name" href="{{ p.url }}">{{ p.title }}</a>
            <p class="b-price">{{ v.price | money }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <script type="application/json" data-b-money>{{ shop.money_format | json }}</script>
</section>
<script>
  (function () {
    var root = document.getElementById('aom-b-{{ section.id }}'); if (!root) return;
    var MF = JSON.parse(root.querySelector('[data-b-money]').textContent), AMT = /\{\{\s*amount[a-z_]*\s*\}\}/;
    function money(c) { var n = (c / 100).toFixed(2); if (/comma/.test(MF)) n = n.replace('.', ','); return MF.replace(AMT, n).replace(/<[^>]*>/g, ''); }
    var PLUS = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>', CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>';
    var picks = [], slots = root.querySelectorAll('[data-b-slot]'), sum = root.querySelector('[data-b-sum]'), go = root.querySelector('[data-b-go]');
    function paint() {
      root.querySelectorAll('[data-b-it]').forEach(function (it) { var on = picks.indexOf(it) > -1; it.classList.toggle('is-on', on); it.querySelector('[data-b-add]').innerHTML = on ? CHECK : PLUS; });
      var prices = picks.map(function (it) { return +it.getAttribute('data-price'); }), full = prices.reduce(function (a, b) { return a + b; }, 0);
      var cheap = picks.length === 3 ? Math.min.apply(null, prices) : -1, giftDone = false;
      slots.forEach(function (s, i) {
        var it = picks[i], g = !!it && !giftDone && +it.getAttribute('data-price') === cheap;
        if (g) giftDone = true;
        s.classList.toggle('is-on', !!it);
        s.innerHTML = it ? '<img src="' + it.getAttribute('data-img') + '" alt="">' + (g ? '<span class="g">Regalo</span>' : '') : '<span class="n">' + (i + 1) + '</span>';
      });
      if (picks.length < 3) {
        var left = 3 - picks.length;
        sum.innerHTML = picks.length === 0 ? 'Elige <b>3 joyas</b>.<br>La de menor precio es un regalo.' : 'Te ' + (left === 1 ? 'falta <b>1 joya</b>' : 'faltan <b>2 joyas</b>') + '.<br>Llevas ' + money(full) + '.';
        go.disabled = true; go.textContent = left === 1 ? 'Elige 1 joya más' : 'Elige ' + left + ' joyas más';
      } else {
        sum.innerHTML = '<span class="t">' + money(full - cheap) + '</span><s>' + money(full) + '</s> · ahorras ' + money(cheap);
        go.disabled = false; go.textContent = 'Añadir mis 3 a la cesta';
      }
    }
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-b-add]');
      if (b) { var it = b.closest('[data-b-it]'), i = picks.indexOf(it); if (i > -1) picks.splice(i, 1); else if (picks.length < 3) picks.push(it); paint(); return; }
      var t = e.target.closest('[data-b-tabs] button');
      if (t) { root.querySelectorAll('[data-b-tabs] button').forEach(function (x) { x.classList.toggle('is-on', x === t); }); var k = t.getAttribute('data-t'); root.querySelectorAll('[data-b-it]').forEach(function (it) { it.hidden = !!k && it.getAttribute('data-type').indexOf(k) < 0; }); }
    });
    go.addEventListener('click', function () {
      var items = picks.map(function (it) { return { id: +it.getAttribute('data-v'), quantity: 1 }; });
      go.disabled = true;
      var p = window.AOMCart ? window.AOMCart.add(items) : fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) }).then(function () { location.href = '/cart'; });
      p.then(function () { picks = []; paint(); }, function () { paint(); });
    });
    paint();
  })();
</script>
{% schema %}
{
  "name": "Elige tus 3 joyas",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Elige tus <em>3 joyas</em>" },
    { "type": "text", "id": "text", "label": "Texto", "default": "La de menor precio es nuestro regalo. Envío gratis y estuche de regalo." },
    { "type": "collection", "id": "collection", "label": "Joyas que se pueden elegir", "info": "Si está vacía o no está publicada, se muestran todas." }
  ],
  "presets": [ { "name": "Elige tus 3 joyas" } ]
}
{% endschema %}
