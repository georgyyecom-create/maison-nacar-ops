{%- comment -%}
  Maison Nácar · Ficha de Calendario de Adviento (v2, 16-nov-2026)
  Pensada para quien llega desde un anuncio en el móvil buscando 1–3 regalos.
  · «Para 1»: miniaturas de los calendarios (enlazan a cada ficha).
  · «Para 3»: el estuche de 3 regalos; en cada fila se elige el calendario. El de menor precio es gratis (3x2 automático).
  · Precio tachado: solo si el dueño rellena «Precio de comparación» (Ómnibus: precio más bajo de los últimos 30 días).
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign v = product.selected_or_first_available_variant
  assign pr = v.price
  assign cmp = v.compare_at_price | default: 0
  assign coll = S.collection
  assign short = product.title | remove: 'Calendario de Adviento ' | strip
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.aom.rating.value.rating
  assign rcount = product.metafields.reviews.rating_count.value | default: product.metafields.aom.rating_count.value | default: 0
  assign cur_i = 0
  if coll != blank
    for p in coll.products limit: 4
      if p.id == product.id
        assign cur_i = forloop.index0
      endif
    endfor
  endif
-%}
<style>
  .mna { --mna-gold: var(--mn-accent); --mna-soft: #F6F4F0; }
  .mna-band { margin: 0; background: var(--mn-ink); color: #fff; font-size: 13px; line-height: 34px; height: 34px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 var(--mn-gutter); }
  .mna-band [data-band-cd] { font-variant-numeric: tabular-nums; color: #E9D3A6; }

  .mna-top { display: grid; }
  @media (min-width: 990px) { .mna-top { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 56px; max-width: var(--mn-max); margin: 0 auto; padding: 28px var(--mn-gutter) 0; } }

  .mna-gal { display: flex; gap: 6px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .mna-gal::-webkit-scrollbar { display: none; }
  .mna-gal figure { position: relative; flex: 0 0 66%; margin: 0; aspect-ratio: 4 / 5; scroll-snap-align: start; background: var(--mna-soft); overflow: hidden; }
  .mna-gal img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 989px) { .mna-gal { padding: 12px var(--mn-gutter) 0; scroll-padding: 0 var(--mn-gutter); } }
  @media (min-width: 990px) { .mna-gal { display: grid; grid-template-columns: 1fr 1fr; overflow: visible; } .mna-gal figure { flex: none; } .mna-gal figure:first-child { grid-column: 1 / -1; } }

  .mna-info { padding: 16px var(--mn-gutter) 0; }
  @media (min-width: 990px) { .mna-info { padding: 0; position: sticky; top: 96px; align-self: start; max-width: 480px; } }
  .mna-t { margin: 0; font-family: var(--mn-display); font-weight: 700; font-size: clamp(30px, 8vw, 44px); line-height: 1; letter-spacing: -.035em; }
  .mna-sub { margin: 6px 0 0; font-size: 15px; color: var(--mn-grey); }
  .mna-stars { display: inline-flex; align-items: center; gap: 3px; margin-top: 8px; font-size: 13.5px; color: var(--mn-ink); text-decoration: none; }
  .mna-stars svg { width: 14px; height: 14px; }
  .mna-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin-top: 12px; }
  .mna-price b { font-family: var(--mn-display); font-size: 30px; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .mna-price s { font-size: 17px; color: var(--mn-grey); text-decoration-color: var(--mna-gold); }
  .mna-save { font-size: 12.5px; font-weight: 600; padding: 3px 10px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--mna-gold); }
  .mna-ship { display: flex; gap: 8px; align-items: flex-start; margin: 10px 0 0; font-size: 14px; line-height: 1.35; }
  .mna-ship svg { flex: none; width: 18px; height: 18px; color: var(--mn-ok); margin-top: 1px; }

  .mna-mode { display: grid; grid-template-columns: 1fr 1fr; margin-top: 18px; padding: 4px; border-radius: 999px; background: var(--mna-soft); }
  .mna-mode button { min-height: 44px; border: 0; border-radius: 999px; background: none; font-size: 14px; font-weight: 600; cursor: pointer; }
  .mna-mode button[aria-pressed="true"] { background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .mna-mode small { font-size: 13px; font-weight: 500; color: var(--mn-grey); }

  .mna-panel { margin-top: 14px; }
  .mna-panel[hidden] { display: none; }
  .mna-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .mna-m { position: relative; display: block; padding: 0; border: 0; background: none; text-align: center; text-decoration: none; color: inherit; cursor: pointer; font-size: 12px; line-height: 1.2; }
  .mna-m img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; background: var(--mna-soft); box-shadow: inset 0 0 0 1px var(--mn-line); transition: box-shadow .15s ease; }
  .mna-m.is-on img, .mna-m[aria-checked="true"] img { box-shadow: 0 0 0 2px var(--mn-ink); }
  .mna-m span { display: block; margin-top: 6px; font-weight: 600; }
  .mna-m em { display: block; font-style: normal; color: var(--mn-grey); }
  .mna-m[disabled] { opacity: .35; cursor: default; }

  .mna-gift { display: grid; gap: 8px; }
  .mna-gift__r { border-radius: 14px; padding: 10px 10px 12px; background: var(--mna-soft); transition: background .2s ease; }
  .mna-gift__r.is-gift { background: var(--mn-nacar); }
  .mna-gift__h { display: flex; justify-content: space-between; align-items: baseline; margin: 0 2px 8px; font-size: 13px; }
  .mna-gift__h b { font-weight: 600; }
  .mna-gift__h span { color: var(--mn-grey); font-variant-numeric: tabular-nums; }
  .mna-gift__r.is-gift .mna-gift__h span { color: var(--mn-ink); font-weight: 600; }
  .mna-gift .mna-m span { font-size: 11.5px; font-weight: 500; }

  .mna-cta { margin-top: 16px; }
  .mna-cta .mn-btn { width: 100%; font-size: 16px; }
  .mna-pay { margin: 10px 0 0; font-size: 13px; color: var(--mn-grey); text-align: center; }
  .mna-pay b { color: var(--mn-ink); font-weight: 600; }
  .mna-icons { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; margin-top: 8px; }
  .mna-icons svg { width: 34px; height: 22px; }

  .mna-trust { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 16px 0 0; padding: 14px 0; border-top: 1px solid var(--mn-line); border-bottom: 1px solid var(--mn-line); text-align: center; font-size: 12px; line-height: 1.3; color: var(--mn-grey); }
  .mna-trust b { display: block; font-size: 13px; font-weight: 600; color: var(--mn-ink); }
  .mna-acc { border-bottom: 1px solid var(--mn-line); }
  .mna-acc summary { display: flex; justify-content: space-between; align-items: center; padding: 15px 0; font-weight: 600; cursor: pointer; list-style: none; }
  .mna-acc summary::-webkit-details-marker { display: none; }
  .mna-acc summary::after { content: ""; width: 9px; height: 9px; border-right: 1.5px solid; border-bottom: 1.5px solid; transform: rotate(45deg) translateY(-3px); transition: transform .2s ease; }
  .mna-acc[open] summary::after { transform: rotate(225deg); }
  .mna-acc__b { padding: 0 0 16px; font-size: 14.5px; line-height: 1.5; }
  .mna-acc__b h3 { font-size: 15px; margin: 12px 0 4px; }
  .mna-acc__b ul { margin: 0; padding-left: 18px; }
  .mna-acc__b p { margin: 6px 0; }

  .mna-sec { padding-top: 52px; }
  @media (min-width: 990px) { .mna-sec { padding-top: 88px; } }
  .mna-h2 { margin: 0; font-family: var(--mn-display); font-weight: 700; font-size: clamp(26px, 6vw, 44px); line-height: 1.02; letter-spacing: -.03em; }
  .mna-lead { margin: 8px 0 0; color: var(--mn-grey); max-width: 46ch; }

  .mna-line { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); margin: 26px 0 0; padding: 0; }
  .mna-line::before { content: ""; position: absolute; left: calc(100% / 12); right: calc(100% / 12); top: 7px; height: 1px; background: var(--mna-gold); opacity: .6; }
  .mna-line li { position: relative; list-style: none; text-align: center; font-size: 12px; color: var(--mn-grey); }
  .mna-line li::before { content: ""; display: block; width: 15px; height: 15px; margin: 0 auto 10px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1.5px var(--mna-gold); }
  .mna-line li:last-child::before { background: var(--mn-nacar); box-shadow: inset 0 0 0 1.5px var(--mn-ink); }
  .mna-line b { display: block; font-family: var(--mn-display); font-size: 22px; line-height: 1; letter-spacing: -.02em; color: var(--mn-ink); }
  .mna-when { margin: 18px 0 0; font-size: 14.5px; }
  .mna-when b { font-variant-numeric: tabular-nums; }

  .mna-who { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 8px; margin-top: 20px; }
  @media (min-width: 990px) { .mna-who { grid-template-columns: repeat(4, 1fr); gap: 14px; } }
  .mna-who figure { margin: 0; }
  .mna-who .mn-ph { aspect-ratio: 4 / 5; }
  .mna-who figcaption { margin-top: 8px; font-size: 13px; line-height: 1.3; color: var(--mn-grey); }
  .mna-who figcaption b { display: block; font-size: 15px; color: var(--mn-ink); }

  .mna-faq { max-width: 760px; padding-bottom: 24px; }
  .mna-faq .mna-h2 { margin-bottom: 18px; }
  .mna-faq .mna-h2 + .mna-acc { border-top: 1px solid var(--mn-line); }

  .mna-bar { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 12px; padding: 10px var(--mn-gutter) calc(10px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid var(--mn-line); transform: translateY(110%); transition: transform .25s var(--mn-ease); }
  .mna-bar.is-on { transform: none; }
  .mna-bar__t { flex: 1; min-width: 0; margin: 0; font-size: 13px; line-height: 1.25; color: var(--mn-grey); }
  .mna-bar__t b { display: block; font-size: 15px; color: var(--mn-ink); font-variant-numeric: tabular-nums; }
  .mna-bar .mn-btn { min-height: 48px; padding: 0 22px; }
  @media (min-width: 990px) { .mna-bar { display: none; } }
  .mn-wa { transition: bottom .25s var(--mn-ease); }
  @media (max-width: 989px) { body:has(.mna-bar.is-on) .mn-wa { bottom: calc(82px + env(safe-area-inset-bottom)); } }
  @media (prefers-reduced-motion: reduce) { .mna-bar, .mna-m img, .mna-gift__r, .mn-wa { transition: none; } }
</style>

<div class="mna" data-mna data-cur="{{ cur_i }}" data-bf="{{ S.bf_end }}" data-ship="{{ S.ship_end }}">
  <p class="mna-band">{{ S.band }}<span data-band-cd></span></p>

  <div class="mna-top">
    <div class="mna-gal" aria-label="Fotos de {{ product.title | escape }}">
      {%- for m in product.media -%}
        {%- if m.media_type == 'image' -%}
          {%- assign ld = 'lazy' -%}{%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- endif -%}
          <figure>{{ m | image_url: width: 1200 | image_tag: loading: ld, sizes: '(min-width: 990px) 55vw, 66vw', widths: '400, 600, 800, 1000, 1200', alt: product.title }}</figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="mna-info">
      <h1 class="mna-t">{{ short }}</h1>
      <p class="mna-sub">{{ S.subtitle }}</p>
      {%- if settings.aom_reviews_on and rating != blank and rcount > 0 -%}
        <a class="mna-stars" href="#opiniones">{%- for i in (1..5) -%}{% render 'mn-icon', i: 'star' %}{%- endfor -%}&nbsp;{{ rating | round: 1 | replace: '.', ',' }} ({{ rcount }})</a>
      {%- endif -%}

      <div class="mna-price" aria-live="polite">
        <b data-price>{{ pr | money_without_trailing_zeros }}</b>
        <s data-ref{% unless cmp > pr %} hidden{% endunless %}>{{ cmp | money_without_trailing_zeros }}</s>
        <span class="mna-save" data-save{% unless cmp > pr %} hidden{% endunless %}>Ahorras {{ cmp | minus: pr | money_without_trailing_zeros }}</span>
      </div>
      <p class="mna-ship"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span>Envío gratis. <span data-ship-txt>{{ S.ship }}</span></span></p>

      <div class="mna-mode" role="group" aria-label="Cuántos regalos">
        <button type="button" aria-pressed="true" data-mode="1">Para 1</button>
        <button type="button" aria-pressed="false" data-mode="3">Para 3 <small>pagas 2</small></button>
      </div>

      {%- if coll != blank -%}
        <div class="mna-panel" data-panel="1">
          <div class="mna-row">
            {%- for p in coll.products limit: 4 -%}
              {%- assign pv = p.selected_or_first_available_variant -%}
              <a class="mna-m{% if p.id == product.id %} is-on{% endif %}" href="{{ p.url }}"{% if p.id == product.id %} aria-current="page"{% endif %}>
                {{ p.featured_image | image_url: width: 240, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                <span>{{ p.title | remove: 'Calendario de Adviento ' | strip }}</span>
                <em>{%- if p.available -%}{%- if pv.inventory_management and pv.inventory_quantity < 30 -%}Quedan {{ pv.inventory_quantity }}{%- else -%}{{ pv.price | money_without_trailing_zeros }}{%- endif -%}{%- else -%}Agotado{%- endif -%}</em>
              </a>
            {%- endfor -%}
          </div>
        </div>

        <div class="mna-panel" data-panel="3" hidden>
          <div class="mna-gift">
            {%- for slot in (1..3) -%}
              <div class="mna-gift__r" data-slot="{{ forloop.index0 }}">
                <p class="mna-gift__h"><b>Regalo {{ slot }}</b><span data-slot-p></span></p>
                <div class="mna-row" role="radiogroup" aria-label="Calendario del regalo {{ slot }}">
                  {%- for p in coll.products limit: 4 -%}
                    <button type="button" class="mna-m" role="radio" aria-checked="{% if p.id == product.id %}true{% else %}false{% endif %}" data-pick="{{ forloop.index0 }}"{% unless p.available %} disabled{% endunless %}>
                      {{ p.featured_image | image_url: width: 200, height: 250, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                      <span>{{ p.title | remove: 'Calendario de Adviento ' | strip }}</span>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="mna-cta">
        {%- if v.available -%}
          <button type="button" class="mn-btn" data-buy><span data-buy-t>Añadir a la cesta</span>&nbsp;·&nbsp;<span data-buy-p>{{ pr | money_without_trailing_zeros }}</span></button>
        {%- else -%}
          <button type="button" class="mn-btn" disabled>Agotado</button>
        {%- endif -%}
      </div>
      <p class="mna-pay">Tarjeta, Bizum o <b>3 plazos de <span data-k>{{ pr | divided_by: 3 | money_without_trailing_zeros }}</span> con Klarna</b>, sin intereses</p>
      <div class="mna-icons" aria-label="Métodos de pago">{%- for t in shop.enabled_payment_types -%}{{ t | payment_type_svg_tag }}{%- endfor -%}</div>

      <ul class="mna-trust">
        <li><b>Caja regalo</b>con lazo</li>
        <li><b>Envío gratis</b>península y Baleares</li>
        <li><b>Devolución</b>hasta el 15 de enero</li>
      </ul>
      <details class="mna-acc"><summary>Qué hay dentro</summary><div class="mna-acc__b">{{ product.description }}</div></details>
    </div>
  </div>

  <section class="mna-sec mn-wrap" aria-labelledby="mna-days">
    <h2 class="mna-h2" id="mna-days">Una joya cada 4 días</h2>
    <p class="mna-lead">Seis cajones numerados. El último se abre en Nochebuena.</p>
    <ol class="mna-line">
      <li><b>4</b>dic</li><li><b>8</b>dic</li><li><b>12</b>dic</li><li><b>16</b>dic</li><li><b>20</b>dic</li><li><b>24</b>dic</li>
    </ol>
    <p class="mna-when" data-when hidden>El primero se abre en <b data-when-cd></b>.</p>
  </section>

  <section class="mna-sec mn-wrap" aria-labelledby="mna-who">
    <h2 class="mna-h2" id="mna-who">¿Para quién es?</h2>
    <div class="mna-who">
      {%- for i in (1..4) -%}
        {%- liquid
          assign k = 'img' | append: i
          assign lk = 'lbl' | append: i
          assign tk = 'ttl' | append: i
          assign ck = 'cap' | append: i
          assign im = S[k]
        -%}
        <figure>
          <div class="mn-ph">
            {%- if im -%}{{ im | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 900', alt: S[lk] }}{%- else -%}<div class="mn-ph__empty"><b>Foto A{{ i }}</b><span>{{ S[lk] }}</span></div>{%- endif -%}
          </div>
          <figcaption><b>{{ S[tk] }}</b>{{ S[ck] }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </section>

  <section class="mna-sec mn-wrap mna-faq" aria-labelledby="mna-faq">
    <h2 class="mna-h2" id="mna-faq">Preguntas</h2>
    <details class="mna-acc"><summary>¿Llega a tiempo?</summary><div class="mna-acc__b"><p>{{ S.faq_time }}</p></div></details>
    <details class="mna-acc"><summary>¿Cómo funciona el 3x2?</summary><div class="mna-acc__b"><p>Elige 3 calendarios, iguales o distintos: el de menor precio sale gratis. Se descuenta solo en la cesta.</p></div></details>
    <details class="mna-acc"><summary>¿De qué material son las joyas?</summary><div class="mna-acc__b"><p>Acero inoxidable en tono dorado o plateado, con cuentas acrílicas y esmalte según el modelo. El detalle está en «Qué hay dentro».</p></div></details>
    <details class="mna-acc"><summary>¿Y si no le gusta?</summary><div class="mna-acc__b"><p>Tiene hasta el 15 de enero para devolverlo.</p></div></details>
  </section>

  {%- if v.available -%}
    <div class="mna-bar" data-bar>
      <p class="mna-bar__t"><b data-bar-p>{{ pr | money_without_trailing_zeros }}</b><span data-bar-t>{{ short }}</span></p>
      <button type="button" class="mn-btn" data-buy>Añadir a la cesta</button>
    </div>
  {%- endif -%}

  <script type="application/json" data-models>[
    {%- for p in coll.products limit: 4 -%}
      {%- assign pv = p.selected_or_first_available_variant -%}
      {"v": {{ pv.id }}, "p": {{ pv.price }}, "c": {{ pv.compare_at_price | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]</script>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-mna]'); if (!root) return;
    var M = []; try { M = JSON.parse(root.querySelector('[data-models]').textContent); } catch (e) {}
    var cur = +root.getAttribute('data-cur') || 0, mode = 1, sel = [cur, cur, cur];
    var self = { v: {{ v.id }}, p: {{ pr | json }}, c: {{ cmp | json }} };
    var $ = function (s) { return root.querySelector(s); }, $$ = function (s) { return root.querySelectorAll(s); };
    function eur(c) { return window.MN ? window.MN.money(c).replace(',00', '') : Math.round(c / 100) + ' €'; }
    function mod(i) { return M[i] || self; }
    function ref(m) { return m.c > m.p ? m.c : m.p; }
    function gift() { var g = 0; sel.forEach(function (i, k) { if (mod(i).p <= mod(sel[g]).p) g = k; }); return g; }
    function calc() {
      if (mode === 1) { var m = mod(cur); return { total: m.p, ref: m.c > m.p ? m.c : 0, n: 1 }; }
      var sum = 0, refs = 0, min = Infinity;
      sel.forEach(function (i) { var m = mod(i); sum += m.p; refs += ref(m); if (m.p < min) min = m.p; });
      return { total: sum - min, ref: refs, n: 3 };
    }
    function paint() {
      var r = calc();
      $('[data-price]').textContent = eur(r.total);
      var s = $('[data-ref]'), sv = $('[data-save]'), show = r.ref > r.total;
      s.hidden = sv.hidden = !show;
      if (show) { s.textContent = eur(r.ref); sv.textContent = 'Ahorras ' + eur(r.ref - r.total); }
      var bp = $('[data-buy-p]'); if (bp) bp.textContent = eur(r.total);
      var bt = $('[data-buy-t]'); if (bt) bt.textContent = r.n === 3 ? 'Añadir los 3' : 'Añadir a la cesta';
      $('[data-k]').textContent = eur(Math.round(r.total / 3));
      var barP = $('[data-bar-p]'); if (barP) { barP.textContent = eur(r.total); $('[data-bar-t]').textContent = r.n === 3 ? '3 calendarios, pagas 2' : {{ short | json }}; }
      if (r.n === 3) {
        var g = gift();
        $$('[data-slot]').forEach(function (row, i) {
          row.classList.toggle('is-gift', i === g);
          row.querySelector('[data-slot-p]').textContent = i === g ? 'Gratis' : eur(mod(sel[i]).p);
          row.querySelectorAll('[data-pick]').forEach(function (b) { b.setAttribute('aria-checked', +b.getAttribute('data-pick') === sel[i]); });
        });
      }
    }
    $$('[data-mode]').forEach(function (b) {
      b.addEventListener('click', function () {
        mode = +b.getAttribute('data-mode');
        $$('[data-mode]').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
        $$('[data-panel]').forEach(function (p) { p.hidden = +p.getAttribute('data-panel') !== mode; });
        paint();
      });
    });
    $$('[data-slot]').forEach(function (row, i) {
      row.addEventListener('click', function (e) { var b = e.target.closest('[data-pick]'); if (!b || b.disabled) return; sel[i] = +b.getAttribute('data-pick'); paint(); });
    });
    $$('[data-buy]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!window.MN) return;
        var q = {};
        (mode === 3 ? sel : [cur]).forEach(function (i) { var id = mod(i).v; q[id] = (q[id] || 0) + 1; });
        b.classList.add('is-busy');
        window.MN.add(Object.keys(q).map(function (id) { return { id: +id, quantity: q[id] }; }))
          .then(function () { b.classList.remove('is-busy'); }, function () { b.classList.remove('is-busy'); });
      });
    });

    /* Cuentas atrás reales: fin de la oferta (solo si el dueño la pone), último día de envío y primer cajón */
    function left(t) { var s = Math.max(0, Math.floor((t - Date.now()) / 1000)), d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60); return d ? d + ' d ' + h + ' h' : h + ' h ' + m + ' min'; }
    var bf = Date.parse(root.getAttribute('data-bf') || ''), sh = Date.parse(root.getAttribute('data-ship') || '');
    var first = new Date(new Date().getFullYear(), 11, 4).getTime();
    function tick() {
      var now = Date.now();
      $('[data-band-cd]').textContent = bf > now ? '. Termina en ' + left(bf) : '';
      if (sh > now) $('[data-ship-txt]').textContent = 'Pide en ' + left(sh) + ' y llega antes del 4 de diciembre.';
      var w = $('[data-when]'); if (first > now) { w.hidden = false; $('[data-when-cd]').textContent = left(first); } else w.hidden = true;
    }
    tick(); setInterval(tick, 30000);

    var bar = $('[data-bar]'), cta = $('.mna-cta');
    if (bar && cta && 'IntersectionObserver' in window) new IntersectionObserver(function (e) { bar.classList.toggle('is-on', !e[0].isIntersecting && e[0].boundingClientRect.top < 0); }).observe(cta);
    paint();
  })();
</script>

