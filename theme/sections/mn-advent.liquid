{%- comment -%}
  Maison Nácar · Ficha de Calendario de Adviento (Navidad 2026)
  · Galería del producto + selector entre los calendarios de la colección elegida.
  · El 3x2 automático también aplica: «Para 3 (pagas 2)».
  · Huecos de foto (A1–A4) para las imágenes de Gemini.
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign v = product.selected_or_first_available_variant
  assign pr = v.price
  assign per = pr | divided_by: 6
  assign coll = S.collection
  assign short = product.title | remove: 'Calendario de Adviento ' | strip
  assign cmp = v.compare_at_price | default: 0
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.aom.rating.value.rating
  assign rcount = product.metafields.reviews.rating_count.value | default: product.metafields.aom.rating_count.value | default: 0
-%}
<style>
  .mn-adv { --adv-wine: #5C1A24; --adv-cream: #FBF6EF; --adv-gold: var(--mn-accent); }
  .mn-adv__band { background: var(--adv-wine); color: #F7E9D7; text-align: center; font-size: 13px; line-height: 1.3; padding: 9px var(--mn-gutter); }
  .mn-adv__band b { color: #fff; letter-spacing: .06em; }
  .mn-adv__band span[data-cd] { display: inline-block; font-variant-numeric: tabular-nums; font-weight: 600; color: #fff; }
  .mn-adv-cd { display: flex; gap: 8px; margin-top: 18px; }
  .mn-adv-cd div { flex: 1; background: #fff; border-radius: 12px; padding: 10px 4px; text-align: center; box-shadow: inset 0 0 0 1px rgba(184,151,90,.55); }
  .mn-adv-cd b { display: block; font-family: var(--mn-display); font-size: 28px; letter-spacing: -.03em; font-variant-numeric: tabular-nums; color: var(--adv-wine); }
  .mn-adv-cd span { font-size: 11px; color: var(--mn-grey); }
  .mn-adv__price s { font-size: 18px; color: var(--mn-grey); }
  .mn-adv__save { display: inline-block; padding: 3px 10px; border-radius: 999px; background: var(--adv-wine); color: #fff; font-size: 12.5px; font-weight: 600; }
  .mn-adv__stars { display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; font-size: 13.5px; text-decoration: none; }
  .mn-adv__stars svg { width: 15px; height: 15px; }
  .mn-adv__opt s { color: var(--mn-grey); margin-right: 3px; }
  .mn-adv__grid { display: grid; }
  @media (min-width: 990px) { .mn-adv__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; max-width: var(--mn-max); margin: 0 auto; padding: 24px var(--mn-gutter) 0; } }
  .mn-adv__gal { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; gap: 6px; }
  .mn-adv__gal::-webkit-scrollbar { display: none; }
  .mn-adv__s { position: relative; flex: 0 0 86%; aspect-ratio: 4 / 5; scroll-snap-align: start; background: var(--adv-cream); }
  .mn-adv__s:only-child { flex-basis: 100%; }
  .mn-adv__s img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mn-adv__s img { object-position: center; }
  @media (max-width: 989px) { .mn-adv__gal { padding: 0 var(--mn-gutter); scroll-padding: 0 var(--mn-gutter); } .mn-adv__s { flex-basis: 72%; } .mn-adv__info { padding-top: 14px; } }
  @media (min-width: 990px) { .mn-adv__gal { display: grid; grid-template-columns: 1fr 1fr; overflow: visible; } .mn-adv__s { flex: none; } .mn-adv__s:first-child { grid-column: 1 / -1; } }
  .mn-adv__tag { position: absolute; left: 12px; top: 12px; padding: 6px 12px; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px var(--adv-gold); font-size: 12.5px; font-weight: 600; }
  .mn-adv__info { padding: 18px var(--mn-gutter) 0; }
  @media (min-width: 990px) { .mn-adv__info { padding: 0; position: sticky; top: 90px; align-self: start; } }
  .mn-adv__eye { margin: 0; font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--adv-wine); }
  .mn-adv__t { margin: 6px 0 0; font-family: var(--mn-display); font-weight: 700; font-size: clamp(30px, 4.4vw, 46px); line-height: 1; letter-spacing: -.03em; }
  .mn-adv__sub { margin: 10px 0 0; font-size: 16px; line-height: 1.45; color: #2a2a2a; }
  .mn-adv__price { display: flex; align-items: baseline; gap: 12px; margin-top: 16px; }
  .mn-adv__price b { font-family: var(--mn-display); font-size: 32px; letter-spacing: -.02em; }
  .mn-adv__price span { font-size: 14px; color: var(--mn-grey); }
  .mn-adv__lbl { margin: 22px 0 10px; font-size: 13px; font-weight: 600; }
  .mn-adv__pick { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .mn-adv__opt { display: block; text-decoration: none; border: 1px solid var(--mn-line); border-radius: 12px; padding: 6px 6px 8px; text-align: center; background: #fff; }
  .mn-adv__opt.is-on { border-color: var(--mn-ink); box-shadow: inset 0 0 0 1px var(--mn-ink); }
  .mn-adv__opt img { display: block; width: 100%; height: auto !important; aspect-ratio: 4 / 5; object-fit: cover; background: var(--adv-cream); border-radius: 8px; }
  .mn-adv__opt b { display: block; margin-top: 6px; font-size: 12px; line-height: 1.15; }
  .mn-adv__opt span { display: block; font-size: 11.5px; color: var(--mn-grey); }
  .mn-adv__opt em { display: block; font-style: normal; font-size: 11px; color: var(--adv-wine); font-weight: 600; }
  .mn-adv__qty { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mn-adv__q { border: 1px solid var(--mn-line); border-radius: 12px; padding: 12px; background: #fff; text-align: left; cursor: pointer; }
  .mn-adv__q.is-on { border-color: var(--mn-ink); box-shadow: inset 0 0 0 1px var(--mn-ink); }
  .mn-adv__q b { display: block; font-size: 14.5px; }
  .mn-adv__q span { display: block; font-size: 12.5px; color: var(--mn-grey); margin-top: 2px; }
  .mn-adv__q i { font-style: normal; display: inline-block; margin-top: 6px; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--mn-nacar); }
  .mn-adv__cta { margin-top: 16px; }
  .mn-adv__ship { margin: 10px 0 0; font-size: 13.5px; text-align: center; }
  .mn-adv__ship b { color: var(--adv-wine); }
  .mn-adv__pay { margin: 12px 0 0; font-size: 13.5px; color: #333; text-align: center; }
  .mn-adv__pay b { font-weight: 600; }
  .mn-adv__icons { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 8px; }
  .mn-adv__icons svg { width: 38px; height: 24px; }
  .mn-adv__trust { list-style: none; padding: 12px 0 0; margin: 14px 0 0; border-top: 1px solid var(--mn-line); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; text-align: center; }
  .mn-adv__trust li { font-size: 12px; line-height: 1.25; color: var(--mn-grey); }
  .mn-adv__trust b { display: block; font-size: 13px; color: var(--mn-ink); }
  .mn-adv__inside { margin-top: 14px; border-top: 1px solid var(--mn-line); border-bottom: 1px solid var(--mn-line); padding: 14px 0; font-size: 14.5px; }
  .mn-adv__inside summary { font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; }
  .mn-adv__inside summary::after { content: "+"; font-size: 20px; line-height: 1; }
  .mn-adv__inside[open] summary::after { content: "–"; }
  .mn-adv__inside h3 { font-size: 17px; margin: 14px 0 6px; }
  .mn-adv__inside ul { margin: 0; padding-left: 18px; }
  .mn-adv__inside p { margin: 8px 0; }
  .mn-adv-days { background: var(--adv-cream); }
  .mn-adv-days__row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin-top: 22px; }
  .mn-adv-days__d { aspect-ratio: 1; display: grid; place-items: center; align-content: center; border-radius: 14px; background: #fff; box-shadow: inset 0 0 0 1px rgba(184,151,90,.55); text-align: center; }
  .mn-adv-days__d b { font-family: var(--mn-display); font-size: clamp(22px, 5vw, 40px); letter-spacing: -.03em; color: var(--adv-wine); }
  .mn-adv-days__d span { font-size: 11px; color: var(--mn-grey); }
  .mn-adv-days__d:last-child { background: var(--adv-wine); }
  .mn-adv-days__d:last-child b, .mn-adv-days__d:last-child span { color: #F7E9D7; }
  .mn-adv-pics { display: grid; gap: 14px 8px; grid-template-columns: 1fr 1fr; margin-top: 18px; }
  @media (min-width: 990px) { .mn-adv-pics { grid-template-columns: repeat(4, 1fr); gap: 12px; } }
  .mn-adv-pics .mn-ph { aspect-ratio: 4 / 5; border-radius: 14px; }
  .mn-adv-pics figure { margin: 0; }
  .mn-adv-pics figcaption { margin-top: 8px; font-size: 13px; line-height: 1.3; color: var(--mn-grey); }
  .mn-adv-pics figcaption b { display: block; font-family: var(--mn-display); font-size: 17px; letter-spacing: -.02em; color: var(--mn-ink); }
  .mn-adv-three { background: var(--adv-wine); color: #F7E9D7; border-radius: 22px; padding: 28px 22px; display: grid; gap: 14px; }
  @media (min-width: 750px) { .mn-adv-three { grid-template-columns: 1.4fr 1fr; align-items: center; padding: 40px; } }
  .mn-adv-three h2 { color: #fff; }
  .mn-adv-three p { margin: 8px 0 0; }
  .mn-adv-faq details { border-bottom: 1px solid var(--mn-line); padding: 14px 0; }
  .mn-adv-faq summary { font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .mn-adv-faq summary::after { content: "+"; font-size: 20px; line-height: 1; }
  .mn-adv-faq details[open] summary::after { content: "–"; }
  .mn-adv-faq p { margin: 8px 0 0; color: #333; }
  .mn-adv-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: 10px; align-items: center; padding: 10px var(--mn-gutter) calc(10px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid var(--mn-line); transform: translateY(110%); transition: transform .25s var(--mn-ease); }
  .mn-adv-bar.is-on { transform: none; }
  .mn-adv-bar__t { flex: 1; min-width: 0; font-size: 13px; line-height: 1.25; }
  .mn-adv-bar__t b { display: block; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mn-adv-bar .mn-btn { min-height: 48px; padding: 0 20px; }
  @media (min-width: 990px) { .mn-adv-bar { display: none; } }
  .mn-wa { transition: bottom .25s var(--mn-ease); }
  @media (max-width: 989px) { body:has(.mn-adv-bar.is-on) .mn-wa { bottom: calc(80px + env(safe-area-inset-bottom)); } }
</style>

<div class="mn-adv">
  <div class="mn-adv__band" data-bf="{{ S.bf_end }}" data-ship="{{ S.ship_end }}"><b>{{ S.band }}</b> <span data-band-msg></span> <span data-cd></span></div>

  <div class="mn-adv__grid">
    <div>
      <div class="mn-adv__gal" aria-label="Fotos del calendario">
        {%- for m in product.media -%}
          {%- if m.media_type == 'image' -%}
            {%- assign malt = m.alt | downcase -%}
            {%- assign ld = 'lazy' -%}{%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- endif -%}
            <div class="mn-adv__s">
              {%- if forloop.first -%}<span class="mn-adv__tag">Edición Navidad 2026</span>{%- endif -%}
              {{ m | image_url: width: 1200 | image_tag: loading: ld, sizes: '(min-width: 990px) 55vw, 86vw', widths: '400, 600, 800, 1000, 1200', alt: product.title }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="mn-adv__info">
      <p class="mn-adv__eye">Calendario de Adviento de joyas</p>
      <h1 class="mn-adv__t">{{ short }}</h1>
      {%- if settings.aom_reviews_on and rating != blank and rcount > 0 -%}<a class="mn-adv__stars" href="#opiniones">{%- for i in (1..5) -%}{% render 'mn-icon', i: 'star' %}{%- endfor -%}<b>{{ rating | round: 1 | replace: '.', ',' }}</b> ({{ rcount }})</a>{%- endif -%}
      <p class="mn-adv__sub">{{ S.subtitle }}</p>
      <div class="mn-adv__price">{%- if cmp > pr -%}<s>{{ cmp | money_without_trailing_zeros }}</s>{%- endif -%}<b data-adv-price>{{ pr | money_without_trailing_zeros }}</b>{%- if cmp > pr -%}<span class="mn-adv__save">Ahorras {{ cmp | minus: pr | money_without_trailing_zeros }}</span>{%- else -%}<span>6 joyas · sale a {{ per | money }} cada una</span>{%- endif -%}</div>

      {%- if coll != blank and coll.products.size > 1 -%}
        <p class="mn-adv__lbl">Elige su calendario</p>
        <div class="mn-adv__pick">
          {%- for p in coll.products limit: 4 -%}
            {%- assign pv = p.selected_or_first_available_variant -%}
            {%- assign pn = p.title | remove: 'Calendario de Adviento ' | strip -%}
            <a class="mn-adv__opt{% if p.id == product.id %} is-on{% endif %}" href="{{ p.url }}"{% if p.id == product.id %} aria-current="true"{% endif %}>
              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: pn }}{%- endif -%}
              <b>{{ pn }}</b>
              <span>{%- if pv.compare_at_price > pv.price -%}<s>{{ pv.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}{{ pv.price | money_without_trailing_zeros }}</span>
              {%- if p.available == false -%}<em>Agotado</em>{%- elsif pv.inventory_management and pv.inventory_quantity < 30 -%}<em>Quedan {{ pv.inventory_quantity }}</em>{%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <p class="mn-adv__lbl">¿Para cuántas?</p>
      <div class="mn-adv__qty" role="radiogroup" aria-label="Cantidad">
        <button type="button" class="mn-adv__q is-on" role="radio" aria-checked="true" data-adv-q="1"><b>Para 1</b><span>{{ pr | money_without_trailing_zeros }}</span></button>
        <button type="button" class="mn-adv__q" role="radio" aria-checked="false" data-adv-q="3"><b>Para 3</b><span>{{ pr | times: 2 | money_without_trailing_zeros }} en total</span><i>3x2: uno gratis</i></button>
      </div>

      <div class="mn-adv__cta">
        {%- if v.available -%}
          <button type="button" class="mn-btn mn-btn--block" data-adv-buy data-v="{{ v.id }}">Regalarlo · <span data-adv-total>{{ pr | money_without_trailing_zeros }}</span></button>
        {%- else -%}
          <button type="button" class="mn-btn mn-btn--block" disabled>Agotado</button>
        {%- endif -%}
      </div>
      <p class="mn-adv__pay">Paga con tarjeta, <b>Bizum</b> o en <b>3 plazos de {{ pr | divided_by: 3 | money }} con Klarna</b>, sin intereses.</p>
      <div class="mn-adv__icons" aria-label="Métodos de pago">{%- for t in shop.enabled_payment_types -%}{{ t | payment_type_svg_tag }}{%- endfor -%}</div>
      {%- if S.ship != blank -%}<p class="mn-adv__ship">{{ S.ship }}</p>{%- endif -%}

      <ul class="mn-adv__trust">
        <li><b>Caja regalo</b>con lazo, lista para dar</li>
        <li><b>Envío gratis</b>península y Baleares</li>
        <li><b>Devolución</b>hasta el 15 de enero</li>
      </ul>

      <details class="mn-adv__inside"><summary>Qué hay dentro · 6 joyas</summary>{{ product.description }}</details>
    </div>
  </div>

  <section class="mn-sec mn-adv-days" style="margin-top:48px">
    <div class="mn-wrap">
      <div class="mn-head"><div><h2 class="mn-h2">Una joya cada 4 días</h2><p>6 cajones numerados. El primero se abre el 4 de diciembre y el último, en Nochebuena.</p></div></div>
      <p class="mn-adv__lbl" data-cd2-l style="margin-bottom:0">Para abrir el primer cajón faltan</p>
      <div class="mn-adv-cd" data-cd2 aria-live="off"><div><b data-u="d">–</b><span>días</span></div><div><b data-u="h">–</b><span>horas</span></div><div><b data-u="m">–</b><span>min</span></div><div><b data-u="s">–</b><span>seg</span></div></div>
      <div class="mn-adv-days__row" aria-hidden="true">
        <div class="mn-adv-days__d"><b>4</b><span>dic</span></div>
        <div class="mn-adv-days__d"><b>8</b><span>dic</span></div>
        <div class="mn-adv-days__d"><b>12</b><span>dic</span></div>
        <div class="mn-adv-days__d"><b>16</b><span>dic</span></div>
        <div class="mn-adv-days__d"><b>20</b><span>dic</span></div>
        <div class="mn-adv-days__d"><b>24</b><span>dic</span></div>
      </div>
    </div>
  </section>

  <section class="mn-sec">
    <div class="mn-wrap">
      <div class="mn-head"><div><h2 class="mn-h2">El regalo que dura todo diciembre</h2><p>No se abre una vez: se abre seis.</p></div></div>
      <div class="mn-adv-pics">
        {%- for i in (1..4) -%}
          {%- liquid
            assign k = 'img' | append: i
            assign lk = 'lbl' | append: i
            assign tk = 'ttl' | append: i
            assign ck = 'cap' | append: i
            assign im = S[k]
          -%}
          <figure>
            <div class="mn-ph">
              {%- if im -%}{{ im | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 900', alt: S[lk] }}{%- else -%}<div class="mn-ph__empty"><b>Foto A{{ i }}</b><span>{{ S[lk] }}</span></div>{%- endif -%}
            </div>
            <figcaption><b>{{ S[tk] }}</b>{{ S[ck] }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="mn-sec" style="padding-top:0">
    <div class="mn-wrap">
      <div class="mn-adv-three">
        <div><h2 class="mn-h2">¿Tienes a más de una en la lista?</h2><p>Llévate 3 calendarios y el de menor precio es gratis. Se aplica solo en la cesta, también si combinas modelos.</p></div>
        <div><button type="button" class="mn-btn mn-btn--white mn-btn--block" data-adv-three>Añadir 3 · {{ pr | times: 2 | money_without_trailing_zeros }}</button></div>
      </div>
    </div>
  </section>

  <section class="mn-sec mn-adv-faq" style="padding-top:0">
    <div class="mn-wrap" style="max-width:820px">
      <div class="mn-head"><div><h2 class="mn-h2">Preguntas</h2></div></div>
      <details><summary>¿Llega a tiempo?</summary><p>{{ S.faq_time }}</p></details>
      <details><summary>¿Cuántas joyas trae y cuándo se abren?</summary><p>6 joyas, cada una en su cajón numerado: 4, 8, 12, 16, 20 y 24 de diciembre.</p></details>
      <details><summary>¿De qué material son?</summary><p>Acero inoxidable en tono dorado o plateado, con cuentas acrílicas y esmalte según el modelo. El detalle de cada calendario está arriba, en «Qué hay dentro».</p></details>
      <details><summary>¿Y si no le gusta?</summary><p>Tiene hasta el 15 de enero para devolverlo, para que pueda abrirlo en Navidad con tranquilidad.</p></details>
      <details><summary>¿Viene listo para regalar?</summary><p>Sí: llega en su caja de regalo con lazo.</p></details>
    </div>
  </section>

  {%- if v.available -%}
    <div class="mn-adv-bar" data-adv-bar>
      <div class="mn-adv-bar__t"><b>{{ product.title }}</b><span data-adv-bar-p>{{ pr | money_without_trailing_zeros }} · envío gratis</span></div>
      <button type="button" class="mn-btn" data-adv-buy data-v="{{ v.id }}">Regalarlo</button>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling, q = 1;
    var price = {{ pr | json }};
    function fmt(c) { return window.MN ? window.MN.money(c).replace(',00', '') : (c / 100) + ' €'; }
    var qs = root.querySelectorAll('[data-adv-q]'), tot = root.querySelectorAll('[data-adv-total]');
    qs.forEach(function (b) {
      b.addEventListener('click', function () {
        q = +b.getAttribute('data-adv-q');
        qs.forEach(function (x) { var on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-checked', on); });
        var t = fmt(q === 3 ? price * 2 : price);
        tot.forEach(function (s) { s.textContent = t; });
      });
    });
    function buy(btn, n) {
      if (!window.MN) return;
      btn.classList.add('is-busy');
      window.MN.add([{ id: +btn.getAttribute('data-v') || +root.querySelector('[data-adv-buy]').getAttribute('data-v'), quantity: n }])
        .then(function () { btn.classList.remove('is-busy'); }, function () { btn.classList.remove('is-busy'); });
    }
    root.querySelectorAll('[data-adv-buy]').forEach(function (b) { b.addEventListener('click', function () { buy(b, q); }); });
    var three = root.querySelector('[data-adv-three]');
    if (three) three.addEventListener('click', function () { buy(three, 3); });
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function parts(ms) { var s = Math.max(0, Math.floor(ms / 1000)); return { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600), m: Math.floor(s % 3600 / 60), s: s % 60 }; }
    var band = root.querySelector('.mn-adv__band'), bmsg = root.querySelector('[data-band-msg]'), bcd = root.querySelector('[data-cd]');
    var bf = Date.parse(band.getAttribute('data-bf') || ''), sh = Date.parse(band.getAttribute('data-ship') || '');
    var first = new Date(new Date().getFullYear(), 11, 4).getTime();
    var cd2 = root.querySelector('[data-cd2]');
    function tick() {
      var now = Date.now(), t, lbl;
      if (bf && bf > now) { t = bf; lbl = 'Termina en'; } else if (sh && sh > now) { t = sh; lbl = 'Pide en'; } else { t = 0; }
      if (t) { var p = parts(t - now); bmsg.textContent = '· ' + lbl; bcd.textContent = (p.d ? p.d + 'd ' : '') + pad(p.h) + ':' + pad(p.m) + ':' + pad(p.s) + (lbl === 'Pide en' ? ' y llega antes del 4 de diciembre' : ''); }
      else { bmsg.textContent = ''; bcd.textContent = ''; }
      if (cd2) {
        if (first > now) { var q = parts(first - now); ['d', 'h', 'm', 's'].forEach(function (u) { cd2.querySelector('[data-u="' + u + '"]').textContent = u === 'd' ? q.d : pad(q[u]); }); }
        else { cd2.hidden = true; var l = root.querySelector('[data-cd2-l]'); if (l) l.hidden = true; }
      }
    }
    tick(); setInterval(tick, 1000);
    var bar = root.querySelector('[data-adv-bar]'), main = root.querySelector('.mn-adv__cta');
    if (bar && main && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { bar.classList.toggle('is-on', !e[0].isIntersecting && e[0].boundingClientRect.top < 0); }).observe(main);
    }
  })();
</script>

