{%- comment -%} Maison Nácar · Página de colección {%- endcomment -%}
{%- assign S = section.settings -%}
<style>
  #aom-col-{{ section.id }} .hd { text-align: center; padding: 36px 16px 22px; }
  #aom-col-{{ section.id }} .hd p { color: var(--aom-muted); max-width: 560px; margin: 10px auto 0; font-size: 15px; line-height: 1.6; }
  #aom-col-{{ section.id }} .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; margin-bottom: 18px; border-top: 1px solid var(--aom-line); border-bottom: 1px solid var(--aom-line); font-size: 13px; color: var(--aom-muted); }
  #aom-col-{{ section.id }} select { border: 0; background: none; font: inherit; color: var(--aom-ink); padding: 6px 0; cursor: pointer; }
  #aom-col-{{ section.id }} .pg { display: flex; justify-content: center; gap: 6px; margin-top: 40px; }
  #aom-col-{{ section.id }} .pg a, #aom-col-{{ section.id }} .pg span { min-width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid var(--aom-line); text-decoration: none; color: var(--aom-ink); font-size: 14px; }
  #aom-col-{{ section.id }} .pg .is-on { background: var(--aom-ink); color: #fff; border-color: var(--aom-ink); }
</style>
<section id="aom-col-{{ section.id }}">
  <div class="hd">
    <span class="aom-kicker">Colección</span>
    <h1 class="aom-h2">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p>{{ collection.description | strip_html | truncate: 220 }}</p>{%- endif -%}
  </div>
  <div class="aom-container" style="padding-bottom:64px">
    {%- paginate collection.products by S.per_page -%}
      <div class="bar">
        <span>{{ collection.products_count }} {% if collection.products_count == 1 %}joya{% else %}joyas{% endif %}</span>
        <label>Ordenar:
          <select onchange="var u=new URL(location.href);u.searchParams.set('sort_by',this.value);u.searchParams.delete('page');location.href=u">
            {%- for o in collection.sort_options -%}<option value="{{ o.value }}"{% if o.value == collection.sort_by %} selected{% endif %}>{{ o.name }}</option>{%- endfor -%}
          </select>
        </label>
      </div>
      <div class="aom-grid aom-grid--4">
        {%- for p in collection.products -%}
          {%- liquid
            assign eager = false
            if forloop.index <= 4
              assign eager = true
            endif
          -%}
          {% render 'aom-card', product: p, eager: eager %}
        {%- else -%}
          <p style="grid-column:1/-1;text-align:center;color:var(--aom-muted)">Pronto añadiremos joyas a esta colección.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pg" aria-label="Páginas">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} class="is-on" aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Colección AOM",
  "settings": [ { "type": "range", "id": "per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 24 } ]
}
{% endschema %}
