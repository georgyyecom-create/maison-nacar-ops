{%- comment -%} Maison Nácar · Nuestra promesa (iconos) {%- endcomment -%}
<style>
  #aom-pm-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.fg }}; }
  #aom-pm-{{ section.id }} ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 18px; }
  @media (min-width: 990px) { #aom-pm-{{ section.id }} ul { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); gap: 32px; } }
  #aom-pm-{{ section.id }} li { text-align: center; }
  #aom-pm-{{ section.id }} svg { width: 34px; height: 34px; fill: none; stroke: var(--aom-gold); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 12px; }
  #aom-pm-{{ section.id }} b { display: block; font-family: var(--aom-serif); font-weight: 400; font-size: 19px; margin-bottom: 6px; }
  #aom-pm-{{ section.id }} span { font-size: 13.5px; line-height: 1.5; opacity: .75; }
</style>
<section id="aom-pm-{{ section.id }}" class="aom-sec">
  <div class="aom-container">
    {%- if section.settings.title != blank -%}<div class="aom-head"><h2 class="aom-h2" style="color:inherit">{{ section.settings.title }}</h2></div>{%- endif -%}
    <ul>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
            {%- when 'return' -%}<svg viewBox="0 0 24 24"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/></svg>
            {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13M12 8S10.5 3 8 4.5 9 8 12 8zm0 0s1.5-5 4-3.5S15 8 12 8z"/></svg>
            {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l3 18 3-18"/></svg>
          {%- endcase -%}
          <b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Promesa AOM",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Comprar aquí es <em>fácil</em>" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#1C1A17" },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#F4EEE4" }
  ],
  "blocks": [
    { "type": "item", "name": "Punto", "settings": [
      { "type": "select", "id": "icon", "label": "Icono", "options": [ { "value": "truck", "label": "Envío" }, { "value": "return", "label": "Devolución" }, { "value": "lock", "label": "Pago" }, { "value": "gift", "label": "Regalo" }, { "value": "chat", "label": "Atención" }, { "value": "gem", "label": "Joya" } ], "default": "truck" },
      { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis" },
      { "type": "text", "id": "text", "label": "Texto", "default": "En 3–7 días laborables" }
    ] }
  ],
  "presets": [ { "name": "Promesa AOM", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
