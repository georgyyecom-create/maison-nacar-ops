{%- comment -%} Maison Nácar · Franja en movimiento {%- endcomment -%}
<style>
  #aom-mq-{{ section.id }} { overflow: hidden; background: {{ section.settings.bg }}; color: {{ section.settings.fg }}; border-top: 1px solid rgba(28,26,23,.08); border-bottom: 1px solid rgba(28,26,23,.08); }
  #aom-mq-{{ section.id }} .tr { display: flex; width: max-content; animation: aom-marquee {{ section.settings.speed }}s linear infinite; }
  #aom-mq-{{ section.id }} .st { display: flex; flex: none; }
  #aom-mq-{{ section.id }} span { display: inline-flex; align-items: center; gap: 28px; padding: 18px 14px; font-family: var(--aom-serif); font-size: clamp(20px, 3vw, 30px); font-style: italic; white-space: nowrap; }
  #aom-mq-{{ section.id }} span::after { content: "✦"; font-style: normal; font-size: 12px; color: var(--aom-gold); }
  @media (prefers-reduced-motion: reduce) { #aom-mq-{{ section.id }} .tr { animation: none; } }
</style>
<div id="aom-mq-{{ section.id }}" aria-hidden="true">
  <div class="tr">
    {%- for n in (1..2) -%}<div class="st">{%- for k in (1..3) -%}{%- for block in section.blocks -%}<span>{{ block.settings.text }}</span>{%- endfor -%}{%- endfor -%}</div>{%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Franja en movimiento",
  "settings": [
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#F4EEE4" },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#1C1A17" },
    { "type": "range", "id": "speed", "label": "Segundos por vuelta", "min": 10, "max": 90, "step": 2, "default": 40 }
  ],
  "blocks": [ { "type": "t", "name": "Texto", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis" } ] } ],
  "presets": [ { "name": "Franja en movimiento", "blocks": [ { "type": "t" }, { "type": "t" }, { "type": "t" } ] } ]
}
{% endschema %}
