{%- comment -%} Maison Nácar · Barra de garantías (portada y producto) {%- endcomment -%}
<style>
  #aom-tb-{{ section.id }} { background: {{ section.settings.bg }}; color: #1C1A17; border-top: 1px solid rgba(28,26,23,.08); border-bottom: 1px solid rgba(28,26,23,.08); }
  #aom-tb-{{ section.id }} ul { list-style: none; margin: 0 auto; padding: 18px 16px; max-width: 1200px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (min-width: 750px) { #aom-tb-{{ section.id }} ul { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr); padding: 22px 32px; } }
  #aom-tb-{{ section.id }} li { display: flex; gap: 10px; align-items: center; font-size: 13px; line-height: 1.35; }
  #aom-tb-{{ section.id }} b { display: block; font-size: 13px; font-weight: 600; }
  #aom-tb-{{ section.id }} span { color: rgba(28,26,23,.62); }
  #aom-tb-{{ section.id }} i { flex: none; width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(168,132,79,.5); display: grid; place-items: center; font-style: normal; color: #A8844F; font-size: 15px; }
</style>
<div id="aom-tb-{{ section.id }}">
  <ul>
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><i aria-hidden="true">{{ block.settings.symbol }}</i><p class="m-0"><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></p></li>
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{
  "name": "Barra de garantías",
  "settings": [ { "type": "color", "id": "bg", "label": "Fondo", "default": "#F4EEE4" } ],
  "blocks": [
    { "type": "item", "name": "Garantía", "settings": [
      { "type": "text", "id": "symbol", "label": "Símbolo", "default": "✦" },
      { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis" },
      { "type": "text", "id": "text", "label": "Texto", "default": "España peninsular" }
    ] }
  ],
  "presets": [ { "name": "Barra de garantías", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
