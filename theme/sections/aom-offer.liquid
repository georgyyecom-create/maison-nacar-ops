{%- comment -%}
  Maison Nácar · Banda de oferta con cuenta atrás
  La cuenta atrás usa la fecha de fin que pongas (oferta real). Al terminar, la banda desaparece sola.
{%- endcomment -%}
{%- assign S = section.settings -%}
<style>
  #aom-of-{{ section.id }} { position: relative; color: #fff; background: var(--aom-ink); overflow: hidden; }
  #aom-of-{{ section.id }} .bg { position: absolute; inset: 0; opacity: .45; }
  #aom-of-{{ section.id }} .bg img { width: 100%; height: 100%; object-fit: cover; }
  #aom-of-{{ section.id }} .in { position: relative; max-width: 900px; margin: 0 auto; padding: 56px 20px; text-align: center; }
  #aom-of-{{ section.id }} .k { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #E7D3AE; margin: 0 0 12px; }
  #aom-of-{{ section.id }} h2 { font-family: var(--aom-serif); font-weight: 400; font-size: clamp(36px, 7vw, 68px); line-height: 1; margin: 0; color: #fff; }
  #aom-of-{{ section.id }} h2 em { color: #E7D3AE; }
  #aom-of-{{ section.id }} p.t { margin: 14px auto 0; max-width: 46ch; color: rgba(255,255,255,.85); font-size: 15px; line-height: 1.55; }
  #aom-of-{{ section.id }} .cd { display: flex; justify-content: center; gap: 10px; margin: 24px 0 26px; }
  #aom-of-{{ section.id }} .cd div { min-width: 64px; padding: 10px 6px; border: 1px solid rgba(231,211,174,.45); }
  #aom-of-{{ section.id }} .cd b { display: block; font-family: var(--aom-serif); font-size: 30px; font-weight: 500; line-height: 1; }
  #aom-of-{{ section.id }} .cd span { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.7); }
</style>
<section id="aom-of-{{ section.id }}" data-end="{{ S.end }}"{% if S.end == blank %} hidden{% endif %}>
  {%- if S.image -%}<div class="bg">{{ S.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '800, 1200, 1600', sizes: '100vw', alt: '' }}{% render 'aom-ai' %}</div>{%- endif -%}
  <div class="in">
    {%- if S.kicker != blank -%}<p class="k">{{ S.kicker }}</p>{%- endif -%}
    <h2>{{ S.title }}</h2>
    {%- if S.text != blank -%}<p class="t">{{ S.text }}</p>{%- endif -%}
    <div class="cd" aria-live="off"><div><b data-u="d">00</b><span>días</span></div><div><b data-u="h">00</b><span>horas</span></div><div><b data-u="m">00</b><span>min</span></div><div><b data-u="s">00</b><span>seg</span></div></div>
    {%- if S.btn != blank -%}<a href="{{ S.link }}" class="aom-btn aom-btn--light">{{ S.btn }}</a>{%- endif -%}
  </div>
</section>
<script>
  (function () {
    var el = document.getElementById('aom-of-{{ section.id }}'); if (!el) return;
    var end = Date.parse(el.getAttribute('data-end')); if (!end) { el.hidden = true; return; }
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var t = Math.floor((end - Date.now()) / 1000);
      if (t <= 0) { el.hidden = true; return; }
      el.hidden = false;
      el.querySelector('[data-u="d"]').textContent = pad(Math.floor(t / 86400));
      el.querySelector('[data-u="h"]').textContent = pad(Math.floor(t % 86400 / 3600));
      el.querySelector('[data-u="m"]').textContent = pad(Math.floor(t % 3600 / 60));
      el.querySelector('[data-u="s"]').textContent = pad(t % 60);
      setTimeout(tick, 1000);
    }
    tick();
  })();
</script>
{% schema %}
{
  "name": "Oferta con cuenta atrás",
  "settings": [
    { "type": "text", "id": "end", "label": "Fin de la oferta", "info": "Formato 2026-11-30T23:59:00+01:00. Vacío = oculta.", "default": "2026-11-30T23:59:00+01:00" },
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "text", "id": "kicker", "label": "Etiqueta", "default": "Black Friday · Maison Nácar" },
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Elige 3, <em>paga 2</em>" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Crea tu set con cualquier pieza de la colección. El descuento se aplica solo en la cesta." },
    { "type": "text", "id": "btn", "label": "Botón", "default": "Crear mi set" },
    { "type": "url", "id": "link", "label": "Enlace", "default": "/collections/all" }
  ],
  "presets": [ { "name": "Oferta con cuenta atrás" } ]
}
{% endschema %}
