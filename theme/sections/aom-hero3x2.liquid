{%- comment -%}
  Maison Nácar · Portada 3x2 (v18)
  Primera pantalla de la home: campaña + titular + los conjuntos con su precio 3x2 + ventajas.
  La etiqueta y el titular salen de la campaña activa (Configuración del tema → Maison Nácar → Campaña),
  salvo que escribas otros aquí.
{%- endcomment -%}
{%- liquid
  assign S = section.settings
  assign sets = section.blocks | where: 'type', 'set'
-%}
<style>
  #aom-h3-{{ section.id }} { background: linear-gradient(180deg, #FBF3EE 0%, var(--aom-ivory) 100%); padding: 18px 0 28px; }
  #aom-h3-{{ section.id }} .h3-top { text-align: center; max-width: 720px; margin: 0 auto; padding: 0 16px; }
  #aom-h3-{{ section.id }} .h3-img { margin: 0 auto 14px; max-width: 1100px; padding: 0 16px; }
  #aom-h3-{{ section.id }} .h3-img img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 20px; display: block; }
  @media (min-width: 990px) { #aom-h3-{{ section.id }} .h3-img img { aspect-ratio: 21 / 8; } }
  #aom-h3-{{ section.id }} h1 { font-family: var(--aom-serif); font-weight: 400; font-size: clamp(34px, 7vw, 64px); line-height: 1.02; letter-spacing: -.01em; margin: 10px 0 0; }
  #aom-h3-{{ section.id }} h1 em { font-style: italic; color: var(--aom-accent); }
  #aom-h3-{{ section.id }} .h3-t { margin: 8px auto 0; max-width: 46ch; font-size: 15px; line-height: 1.5; color: var(--aom-muted); }
  #aom-h3-{{ section.id }} .h3-sets { display: grid; gap: 14px; max-width: 1100px; margin: 18px auto 0; padding: 0 16px; }
  @media (min-width: 750px) { #aom-h3-{{ section.id }} .h3-sets { grid-template-columns: repeat({{ sets.size | at_least: 1 | at_most: 3 }}, 1fr); gap: 20px; } }
  /* En móvil, los conjuntos en carrusel para que se vean los dos en la primera pantalla */
  @media (max-width: 749px) {
    #aom-h3-{{ section.id }} .h3-sets { grid-auto-flow: column; grid-auto-columns: 84%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
    #aom-h3-{{ section.id }} .h3-sets::-webkit-scrollbar { display: none; }
    #aom-h3-{{ section.id }} .h3-sets > * { scroll-snap-align: center; }
  }
  #aom-h3-{{ section.id }} .h3-own { display: flex; justify-content: center; margin-top: 14px; }
  #aom-h3-{{ section.id }} .h3-own a { font-size: 14px; font-weight: 600; color: var(--aom-ink); text-underline-offset: 4px; }
  #aom-h3-{{ section.id }} .h3-icons { list-style: none; margin: 18px auto 0; padding: 0 16px; max-width: 1100px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; justify-content: flex-start; }
  #aom-h3-{{ section.id }} .h3-icons::-webkit-scrollbar { display: none; }
  @media (min-width: 990px) { #aom-h3-{{ section.id }} .h3-icons { justify-content: center; flex-wrap: wrap; } }
  #aom-h3-{{ section.id }} .h3-icons li { flex: none; display: flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--aom-line); font-size: 12.5px; white-space: nowrap; }
</style>
<section id="aom-h3-{{ section.id }}">
  {%- if S.image -%}
    <div class="h3-img">{{ S.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800', sizes: '100vw', alt: S.image.alt | default: '' }}</div>
  {%- endif -%}
  <div class="h3-top">
    <span class="aom-sticker aom-sticker--red">{%- if S.kicker != blank -%}{{ S.kicker }}{%- else -%}{% render 'aom-camp', k: 'kicker' %}{%- endif -%}</span>
    <h1>{%- if S.title != blank -%}{{ S.title }}{%- else -%}{% render 'aom-camp', k: 'title' %}{%- endif -%}</h1>
    {%- if S.text != blank -%}<p class="h3-t">{{ S.text }}</p>{%- endif -%}
  </div>
  {%- if sets.size > 0 -%}
    <div class="h3-sets">
      {%- for block in sets -%}
        <div {{ block.shopify_attributes }}>{% render 'aom-setcard', items: block.settings.products, title: block.settings.title, badge: block.settings.badge, image: block.settings.image, add: true %}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if S.own_text != blank -%}<p class="h3-own"><a href="{{ S.own_link }}">{{ S.own_text }}</a></p>{%- endif -%}
  {%- if S.icons != blank -%}
    {%- assign ics = S.icons | newline_to_br | split: '<br />' -%}
    <ul class="h3-icons">{%- for ic in ics -%}{%- assign t = ic | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Portada 3x2",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto de ambiente (opcional)", "info": "Sale arriba, apaisada. Si no pones ninguna, la portada empieza directamente con la oferta." },
    { "type": "text", "id": "kicker", "label": "Etiqueta (vacío = la de la campaña)" },
    { "type": "inline_richtext", "id": "title", "label": "Titular (vacío = el de la campaña)" },
    { "type": "text", "id": "text", "label": "Texto", "default": "3 joyas por el precio de 2: la de menor precio te sale gratis. Acero inoxidable con baño de oro 18k, en su estuche de regalo." },
    { "type": "text", "id": "own_text", "label": "Enlace «arma tu 3x2»", "default": "O elige tus 3 joyas →" },
    { "type": "text", "id": "own_link", "label": "Enlace", "default": "/pages/3x2" },
    { "type": "textarea", "id": "icons", "label": "Ventajas (una por línea)", "default": "🚚 Envío gratis · Sale en 24/48 h\n🎁 Estuche de regalo\n↩️ Devolución hasta el 15 de enero\n✨ Acero inoxidable con baño de oro 18k\n💳 Bizum, tarjeta y PayPal\n💬 WhatsApp" }
  ],
  "blocks": [
    {
      "type": "set", "name": "Conjunto",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Conjunto" },
        { "type": "product_list", "id": "products", "label": "Las 3 piezas (la más barata, la última)", "limit": 3 },
        { "type": "text", "id": "badge", "label": "Etiqueta" },
        { "type": "image_picker", "id": "image", "label": "Foto del conjunto puesto (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "Portada 3x2" } ]
}
{% endschema %}
